			<Item class="ModuleScript" referent="RBX9">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[--!strict
local Rules = {}
function Rules.finite(n: any): boolean
    return type(n) == "number" and n == n and math.abs(n) < math.huge
end
function Rules.rank(xp: number, trained: boolean): number
    if not trained then return 1 end
    if xp >= 900 then return 5 end
    if xp >= 500 then return 4 end
    if xp >= 250 then return 3 end
    return 2
end
function Rules.canJoin(trained: boolean, requested: any, ownCount: number, otherCount: number): boolean
    return trained and (requested == "Blue" or requested == "Red") and ownCount <= otherCount
end
function Rules.canDamage(phase: string, attacker: string, victim: string, protected: boolean): boolean
    return phase == "Active" and not protected
        and (attacker == "Blue" or attacker == "Red")
        and (victim == "Blue" or victim == "Red") and attacker ~= victim
end
function Rules.canFire(now: number, lastShot: number, interval: number, ammo: number, reloading: boolean): boolean
    return ammo > 0 and not reloading and now - lastShot >= interval
end
return table.freeze(Rules)
]]></ProtectedString>
