		<Item class="ModuleScript" referent="RBX12">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
export type Session = {
    xp: number, trained: boolean, hits: number, team: string, squad: number,
    ammo: number, reloading: boolean, lastShot: number, generation: number,
    lastTeamChange: number, buckets: {[string]: {tokens: number, updated: number}},
}
local Sessions = {}
local data: {[Player]: Session} = {}
function Sessions.get(player: Player): Session?
    return data[player]
end
function Sessions.publish(player: Player)
    local s = data[player]
    if not s then return end
    player:SetAttribute("XP", s.xp)
    player:SetAttribute("Rank", Config.RankNames[Rules.rank(s.xp, s.trained)])
    player:SetAttribute("Trained", s.trained)
    player:SetAttribute("TrainingHits", s.hits)
    player:SetAttribute("Side", s.team)
    player:SetAttribute("Squad", s.squad)
    player:SetAttribute("Ammo", s.ammo)
    player:SetAttribute("Reloading", s.reloading)
end
function Sessions.add(player: Player)
    data[player] = {xp=0, trained=false, hits=0, team="Training", squad=0,
        ammo=Config.Magazine, reloading=false, lastShot=-math.huge, generation=0,
        lastTeamChange=-math.huge, buckets={}}
    Sessions.publish(player)
end
function Sessions.remove(player: Player) data[player] = nil end
function Sessions.resetWeapon(player: Player)
    local s = data[player]
    if not s then return end
    s.generation += 1
    s.ammo = Config.Magazine
    s.reloading = false
    s.lastShot = -math.huge
    Sessions.publish(player)
end
-- Separate token buckets prevent malformed remote spam from reaching expensive raycasts.
function Sessions.allow(player: Player, key: string, rate: number, burst: number): boolean
    local s = data[player]
    if not s then return false end
    local now = os.clock()
    local b = s.buckets[key]
    if not b then b = {tokens=burst, updated=now}; s.buckets[key] = b end
    b.tokens = math.min(burst, b.tokens + (now-b.updated)*rate)
    b.updated = now
    if b.tokens < 1 then return false end
    b.tokens -= 1
    return true
end
function Sessions.count(team: string, squad: number?): number
    local count = 0
    for player, s in data do
        if player.Parent == Players and s.team == team and (squad == nil or s.squad == squad) then count += 1 end
    end
    return count
end
return Sessions
]]></ProtectedString>
				<string name="ScriptGuid">{3147749d-4a86-414a-ab9c-a190440bb13b}</string>
