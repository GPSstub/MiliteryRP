		<Item class="ModuleScript" referent="RBX10">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))
local Sessions = require(script.Parent:WaitForChild("Sessions"))
local Combat = {}
local function living(player: Player): (Model?, Humanoid?, BasePart?)
    local c = player.Character
    if not c or c:FindFirstChildOfClass("ForceField") then return nil,nil,nil end
    local h = c:FindFirstChildOfClass("Humanoid")
    local head = c:FindFirstChild("Head")
    local tool = c:FindFirstChild("ServiceRifle")
    if not h or h.Health <= 0 or not head or not head:IsA("BasePart")
        or not tool or not tool:IsA("Tool") or tool:GetAttribute("ServerIssued") ~= true then
        return nil,nil,nil
    end
    return c,h,head
end
function Combat.reload(player: Player)
    if not Sessions.allow(player,"reload",2,2) then return end
    local s = Sessions.get(player)
    if not s or s.reloading or s.ammo == Config.Magazine or not living(player) then return end
    s.reloading = true
    local generation = s.generation
    Sessions.publish(player)
    task.delay(Config.ReloadSeconds,function()
        if Sessions.get(player) ~= s or s.generation ~= generation then return end
        s.reloading = false
        if living(player) then s.ammo = Config.Magazine end
        Sessions.publish(player)
    end)
end
function Combat.fire(player: Player, direction: any, round: any, targets: Folder)
    if not Sessions.allow(player,"fire",12,3) then return end
    if typeof(direction) ~= "Vector3" or not Rules.finite(direction.X)
        or not Rules.finite(direction.Y) or not Rules.finite(direction.Z) then return end
    if math.abs(direction.Magnitude - 1) > 0.01 then return end
    local s = Sessions.get(player)
    if not s then return end
    if s.team ~= "Training" and round.phase ~= "Active" then return end
    local c, _, head = living(player)
    if not c or not head then return end
    local now = os.clock()
    if not Rules.canFire(now,s.lastShot,Config.FireInterval,s.ammo,s.reloading) then return end
    s.lastShot = now
    s.ammo -= 1
    Sessions.publish(player)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {c}
    -- No client origin, hit part, damage or target identity is accepted.
    local result = workspace:Raycast(head.Position,direction.Unit*Config.Range,params)
    if not result then return end
    if s.team == "Training" and result.Instance.Parent == targets and not s.trained then
        s.hits += 1
        if s.hits >= Config.TrainingHits then s.trained=true; s.xp=100 end
        Sessions.publish(player)
        return
    end
    local model = result.Instance:FindFirstAncestorOfClass("Model")
    if not model then return end
    local victim = Players:GetPlayerFromCharacter(model)
    local targetSession = if victim then Sessions.get(victim) else nil
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not victim or not targetSession or not humanoid or humanoid.Health <= 0 then return end
    if not Rules.canDamage(round.phase,s.team,targetSession.team,model:FindFirstChildOfClass("ForceField") ~= nil) then return end
    local before = humanoid.Health
    humanoid:TakeDamage(Config.Damage)
    if before > 0 and humanoid.Health <= 0 then
        round.scores[s.team] += 1
        s.xp += 25
        Sessions.publish(player)
        round.publish()
    end
end
return Combat
]]></ProtectedString>
