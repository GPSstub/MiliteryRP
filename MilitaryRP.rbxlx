			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXc964fa98844d4e58a27bb6060e918a13">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<ProtectedString name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RankCatalog"))
type Rank = Catalog.Rank
local Insignia = {}
local ATLAS = "rbxassetid://97383962049559"
local COLUMNS, ROWS = 4, 5
function Insignia.render(tag: Instance, rank: Rank)
    local previous = tag:FindFirstChild("Insignia")
    if previous then previous:Destroy() end
    local plate = Instance.new("Frame")
    plate.Name = "Insignia"
    plate.AnchorPoint = Vector2.new(0.5, 0)
    plate.Position = UDim2.new(0.5, 0, 0, 24)
    plate.Size = UDim2.fromOffset(38, 38)
    plate.BackgroundTransparency = 1
    plate.BorderSizePixel = 0
    plate.ClipsDescendants = true
    plate:SetAttribute("RankId", rank.id)
    plate:SetAttribute("Symbol", rank.symbol)
    plate:SetAttribute("Marks", rank.marks)
    plate.Parent = tag
    -- The icon atlas contains exactly the original 20 military ranks.
    -- The persisted admin rank has its own nameplate, not an atlas tile.
    if rank.symbol == "training" or rank.symbol == "admin" then return end
    local index = rank.order - 1
    local column, row = index % COLUMNS, math.floor(index / COLUMNS)
    -- Normalized clipping remains correct if Roblox resizes the uploaded texture.
    local image = Instance.new("ImageLabel")
    image.Name = "Atlas"
    image.BackgroundTransparency = 1
    image.BorderSizePixel = 0
    image.Image = ATLAS
    image.ScaleType = Enum.ScaleType.Stretch
    image.Size = UDim2.fromScale(COLUMNS, ROWS)
    image.Position = UDim2.fromScale(-column, -row)
    image.Parent = plate
end
return Insignia
</ProtectedString>
				<string name="ScriptGuid">{6b7b055f-7876-4d3a-9563-21e6b1ea6d00}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RankInsignia</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">08c4e9987925be9f0ae78ca800000f5a</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8d14c6b162fe493695e5f9f861e5f7c4">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<ProtectedString name="Source">--!strict
-- Supports ;계급 나 대위, ;계급 일부 대위, and DisplayNames with spaces.
export type Command={kind: string,target: string?,rank: string?}
local Parser={}

function Parser.parse(message: any): Command?
    if type(message)~="string" or #message&gt;256 or not utf8.len(message) then return nil end
    local verb,arguments=message:match("^%s*(%S+)%s*(.-)%s*$")
    if not verb then return nil end
    local alias=string.lower(verb)
    if alias==";계급목록" or alias==";ranks" then
        return if arguments=="" then {kind="list"} else nil
    end
    if alias~=";계급" and alias~=";rank" then return nil end
    if arguments=="" or arguments:find("[%c]") then return nil end
    -- The last word is a rank name or ID. Everything before it can be an
    -- arbitrary Unicode DisplayName, optionally containing spaces.
    local target,rank=arguments:match("^(.-)%s+(%S+)$")
    if not rank then
        rank=arguments
        target=nil
    else
        target=target:match("^%s*(.-)%s*$") or ""
        if target=="" or #target&gt;100 then return nil end
        if target:sub(1,1)=='"' and target:sub(-1)=='"' then
            target=target:sub(2,-2)
        end
        if target=="" then return nil end
    end
    if #rank&gt;60 or rank:find("[;]") then return nil end
    return {kind="set",target=target,rank=rank}
end
return table.freeze(Parser)
</ProtectedString>
				<string name="ScriptGuid">{9a72c432-67a1-4a78-85fb-272afd6b0d86}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RankCommandParser</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">08c4e9987925be9f0ae78ca800000f5c</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX7c6bbcabd7e84de78922065eae2df9a0">
			<Properties>
				<Content name="LinkedSource"><null /></Content>
				<ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local TextChatService=game:GetService("TextChatService")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Catalog=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RankCatalog"))
local RankService=require(script.Parent:WaitForChild("RankService"))
local Parser=require(script.Parent:WaitForChild("RankCommandParser"))
local TeamService=require(script.Parent:WaitForChild("TeamService"))
local TargetPicker=require(script.Parent:WaitForChild("AdminTargetSelection"))
-- Administrator commands are authorized by server-verified Roblox group rank.
-- No team transfer or rank promotion can grant administrator authority.
local lastCommand: {[Player]: number}={}
local started=false
local Commands={}
local Audit=require(script.Parent:WaitForChild("AdminAudit"))
local function handle(actor: Player, text: any): (boolean, string, boolean?)
    if typeof(actor)~="Instance" or not actor:IsA("Player") or actor.Parent~=Players
        or not TeamService.isAdmin(actor) then
        return false,"계급 변경 명령어는 Roblox 그룹 운영진 전용입니다."
    end
    local now=os.clock()
    if now-(lastCommand[actor] or -math.huge)&lt;0.5 then
        return false,"잠시 후 다시 입력하세요."
    end
    lastCommand[actor]=now
    TargetPicker.clear(actor)
    local command=Parser.parse(text)
    if not command then
        return false,"사용법: ;계급 대위 · ;계급 닉네임 대위 · ;계급목록"
    end
    if command.kind=="list" then
        TargetPicker.clear(actor)
        local names: {string}={}
        for _,rank in Catalog.All do table.insert(names,rank.name) end
        return true,table.concat(names," · ")
    end
    local rank=nil
    for _,candidate in Catalog.All do
        if candidate.name==command.rank or candidate.id==command.rank then rank=candidate;break end
    end
    if not rank then return false,"없는 계급입니다. ;계급목록으로 확인하세요." end
    local desiredId=rank.id
    local desiredName=rank.name
    local function applyTo(selected: Player): (boolean,string)
        -- Pending selections are validated again before the persistent write.
        if not TeamService.isAdmin(actor) or selected.Parent~=Players then
            return false,"그룹 운영진 권한 또는 대상 접속 상태를 다시 확인하세요."
        end
        local saved,saveError=RankService.set(selected,desiredId)
        local success=saved==true
        local message=if success then selected.Name.." → "..desiredName
            else saveError or "계급을 저장하지 못했습니다."
        Audit.record(actor,text,success,message)
        return success,message
    end
    if not command.target then
        TargetPicker.clear(actor)
        local saved,saveError=RankService.set(actor,desiredId)
        return saved,if saved then actor.Name.." → "..desiredName
            else saveError or "계급을 저장하지 못했습니다."
    end
    local found,reason,pending=TargetPicker.resolve(actor,command.target,applyTo)
    if not found then
        return false,reason or "대상 플레이어를 찾지 못했습니다.",pending
    end
    local saved,saveError=RankService.set(found,desiredId)
    return saved,if saved then found.Name.." → "..desiredName
        else saveError or "계급을 저장하지 못했습니다."
end
function Commands.handle(actor: Player, text: any): (boolean, string, boolean?)
    local ok,message,pending=handle(actor,text)
    if not pending and typeof(actor)=="Instance" and actor:IsA("Player")
        and TeamService.isAdmin(actor) and type(text)=="string" then
        Audit.record(actor,text,ok,message)
    end
    return ok,message,pending
end
function Commands.start()
    if started then return end
    started=true
    TeamService.start()
    TargetPicker.start()
    local feedback=Instance.new("RemoteEvent")
    feedback.Name="RankCommandFeedback";feedback.Parent=ReplicatedStorage
    -- TextChatCommand supports non-slash aliases (such as ';') in Roblox's
    -- current TextChatService. The command is consumed by the engine rather
    -- than being sent as a normal message to other players.
    for _,spec in {{"SetMilitaryRank",";계급",";rank"},{"ListMilitaryRanks",";계급목록",";ranks"}} do
        local command=Instance.new("TextChatCommand")
        command.Name=spec[1];command.PrimaryAlias=spec[2];command.SecondaryAlias=spec[3]
        command.Enabled=true
        command.Triggered:Connect(function(source: TextSource, text: string)
            if not source then return end
            local actor=Players:GetPlayerByUserId(source.UserId)
            if not actor then return end
            local _,message=Commands.handle(actor,text)
            feedback:FireClient(actor,message)
        end)
        command.Parent=TextChatService
    end
    Players.PlayerRemoving:Connect(function(player: Player) lastCommand[player]=nil end)
end
return Commands
</ProtectedString>
				<string name="ScriptGuid">{14aa79a6-2a24-4a94-9d39-7e01204858d8}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RankCommands</string>
				<BinaryString name="SerializedOverrides" />
