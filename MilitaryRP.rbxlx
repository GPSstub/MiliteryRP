			<Item class="LocalScript" referent="RBX13">
				<Properties>
					<ProtectedString name="Source"><![CDATA[--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ContextActionService=game:GetService("ContextActionService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local Config=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local remotes=ReplicatedStorage:WaitForChild("Remotes")
local fire=remotes:WaitForChild("Fire") :: RemoteEvent
local reload=remotes:WaitForChild("Reload") :: RemoteEvent
local joinTeam=remotes:WaitForChild("JoinTeam") :: RemoteEvent
local joinSquad=remotes:WaitForChild("JoinSquad") :: RemoteEvent
local gui=Instance.new("ScreenGui"); gui.Name="MilitaryHUD"; gui.ResetOnSpawn=false
local panel=Instance.new("Frame"); panel.Size=UDim2.new(0,340,0,270); panel.Position=UDim2.fromOffset(15,15)
panel.BackgroundColor3=Color3.fromRGB(25,33,29); panel.BackgroundTransparency=0.1; panel.Parent=gui
local status=Instance.new("TextLabel"); status.Position=UDim2.fromOffset(10,10); status.Size=UDim2.new(1,-20,0,140)
status.TextColor3=Color3.new(1,1,1); status.BackgroundTransparency=1; status.TextSize=16
status.TextXAlignment=Enum.TextXAlignment.Left; status.TextYAlignment=Enum.TextYAlignment.Top; status.Parent=panel
local message=Instance.new("TextLabel"); message.Position=UDim2.fromOffset(10,225); message.Size=UDim2.new(1,-20,0,40)
message.BackgroundTransparency=1; message.TextColor3=Color3.fromRGB(255,214,120); message.TextSize=14; message.TextWrapped=true
message.Text="훈련: 노란 표적 5회 명중 → 팀 선택"; message.Parent=panel
local function button(text: string, x: number, y: number, callback: () -> ())
    local b=Instance.new("TextButton"); b.Text=text; b.TextSize=15; b.Size=UDim2.fromOffset(100,30)
    b.Position=UDim2.fromOffset(x,y); b.BackgroundColor3=Color3.fromRGB(62,82,66); b.TextColor3=Color3.new(1,1,1)
    b.Parent=panel; b.Activated:Connect(callback)
end
button("청군 입대",10,150,function() joinTeam:FireServer("Blue"); message.Text="수료·인원 균형·변경 대기시간 충족 시 배치됩니다." end)
button("홍군 입대",120,150,function() joinTeam:FireServer("Red"); message.Text="전투 중에는 소속 팀을 변경할 수 없습니다." end)
for i=1,3 do button(i.."분대",10+(i-1)*110,190,function() joinSquad:FireServer(i) end) end
local cross=Instance.new("TextLabel"); cross.AnchorPoint=Vector2.new(0.5,0.5); cross.Position=UDim2.fromScale(0.5,0.5)
cross.Size=UDim2.fromOffset(24,24); cross.BackgroundTransparency=1; cross.Text="+"; cross.TextSize=24
cross.TextColor3=Color3.new(1,1,1); cross.Parent=gui
local mouse=player:GetMouse()
local currentTool: Tool?=nil
local activatedConnection: RBXScriptConnection?=nil
local lastLocalShot=-math.huge
local function shoot()
    if os.clock()-lastLocalShot < Config.FireInterval then return end
    if not currentTool or currentTool.Parent ~= player.Character then return end
    local c=player.Character; local head=if c then c:FindFirstChild("Head") else nil
    if not head or not head:IsA("BasePart") then return end
    local delta=mouse.Hit.Position-head.Position
    if delta.Magnitude < 0.01 then return end
    lastLocalShot=os.clock(); fire:FireServer(delta.Unit)
end
local function bindTool(child: Instance)
    if not child:IsA("Tool") or child.Name ~= "ServiceRifle" then return end
    if activatedConnection then activatedConnection:Disconnect() end
    currentTool=child; activatedConnection=child.Activated:Connect(shoot)
end
local function characterAdded(c: Model)
    if activatedConnection then activatedConnection:Disconnect(); activatedConnection=nil end
    currentTool=nil
    c.ChildAdded:Connect(bindTool)
    for _, child in c:GetChildren() do bindTool(child) end
end
player.CharacterAdded:Connect(characterAdded)
if player.Character then characterAdded(player.Character) end
ContextActionService:BindAction("ReloadRifle",function(_,state)
    if state == Enum.UserInputState.Begin then reload:FireServer() end
    return Enum.ContextActionResult.Sink
end,true,Enum.KeyCode.R)
ContextActionService:SetTitle("ReloadRifle","재장전")
-- Force third-person distance when opening menus so the cursor is available.
local function setView(firstPerson: boolean)
    player.CameraMinZoomDistance=if firstPerson then 0.5 else 8
    player.CameraMode=if firstPerson then Enum.CameraMode.LockFirstPerson else Enum.CameraMode.Classic
end
player:GetAttributeChangedSignal("Side"):Connect(function()
    setView(player:GetAttribute("Side") ~= "Training")
end)
ContextActionService:BindAction("ToggleMenu",function(_,state)
    if state == Enum.UserInputState.Begin then
        setView(player.CameraMode ~= Enum.CameraMode.LockFirstPerson)
    end
    return Enum.ContextActionResult.Sink
end,false,Enum.KeyCode.M)
setView(player:GetAttribute("Side") ~= nil and player:GetAttribute("Side") ~= "Training")
gui.Parent=player:WaitForChild("PlayerGui")
local sideNames={Training="훈련병",Blue="청군",Red="홍군"}
local elapsed=0
RunService.Heartbeat:Connect(function(dt)
    elapsed+=dt; if elapsed < 0.1 then return end; elapsed=0
    local remaining=math.max(0,math.ceil((ReplicatedStorage:GetAttribute("RoundEndsAt") or 0)-workspace:GetServerTimeNow()))
    status.Text=string.format("군대 RP · 시스템 MVP\n%s | XP %d | %s / %d분대\n훈련 %d/%d | 탄약 %d/%d %s\n%s · %d초 | 청군 %d : %d 홍군\n1: 소총 장착 · 클릭: 사격 · R: 재장전\nM: 시점/메뉴 전환 · 재접속 시 초기화",
        player:GetAttribute("Rank") or "훈련병",player:GetAttribute("XP") or 0,sideNames[player:GetAttribute("Side") or "Training"] or "훈련병",
        player:GetAttribute("Squad") or 0,player:GetAttribute("TrainingHits") or 0,Config.TrainingHits,
        player:GetAttribute("Ammo") or 0,Config.Magazine,if player:GetAttribute("Reloading") then "재장전 중" else "",
        if ReplicatedStorage:GetAttribute("RoundPhase") == "Active" then "전투" else "대기",remaining,
        ReplicatedStorage:GetAttribute("BlueScore") or 0,ReplicatedStorage:GetAttribute("RedScore") or 0)
end)
]]></ProtectedString>
