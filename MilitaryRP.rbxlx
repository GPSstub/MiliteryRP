			<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
			<UniqueId name="UniqueId">08c4e9987925be9f0ae78ca8000003a7</UniqueId>
		</Properties>
		<Item class="AvatarRules" referent="RBX9badfb9ec6cf434aae788759762ec476">
			<Properties>
				<token name="AvatarType">1</token>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DefaultAvatarRules</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">2be91129643772e20ae934c500000f27</UniqueId>
			</Properties>
			<Item class="AvatarBodyRules" referent="RBX0714e70425e34222bda3fd554a804868">
				<Properties>
					<token name="AppearanceMode">0</token>
					<token name="AvatarType">1</token>
					<token name="BuildMode">0</token>
