			</Properties>
		</Item>
	<Item class="Script" referent="MessengerSync1"><Properties><string name="Name">TrainingRifle</string><ProtectedString name="Source">--!strict
-- Polished single-tool training carbine: server grants it, authorizes every shot,
-- supplies positional SFX, and animates magazine/bolt for other players too.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ServerStorage=game:GetService("ServerStorage")
local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local MarketplaceService=game:GetService("MarketplaceService")
local Rules=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TrainingRifleRules"))
local PurchaseConfig=require(script.Parent:WaitForChild("TrainingRiflePurchaseConfig"))
ReplicatedStorage:SetAttribute("TrainingRifleGamePassId",PurchaseConfig.GAME_PASS_ID)
local PassAccess=require(script.Parent:WaitForChild("RiflePassAccess"))
local access=PassAccess.new({
    passId=PurchaseConfig.GAME_PASS_ID,
    cacheSeconds=PurchaseConfig.OWNERSHIP_CACHE_SECONDS,
    retrySeconds=PurchaseConfig.ERROR_RETRY_SECONDS,
    clock=os.clock,
    lookup=function(userId: number,passId: number): boolean
        return MarketplaceService:UserOwnsGamePassAsync(userId,passId)
    end,
})
if not PassAccess.validPassId(PurchaseConfig.GAME_PASS_ID) then
    warn("[TrainingRifle] 구매 게임패스 ID가 설정되지 않아 총기 지급이 잠겼습니다.")
end
local remote=Instance.new("RemoteEvent")
remote.Name="TrainingRifleAction"
remote.Parent=ReplicatedStorage

local sessions: {[Tool]: Rules.WeaponState}={}
local lastRemote: {[Player]: number}={}
local STEEL=Color3.fromRGB(46,50,53)
local DARK=Color3.fromRGB(24,28,31)
local OLIVE=Color3.fromRGB(79,85,72)
local ORANGE=Color3.fromRGB(223,158,63)
-- Measured in Studio: the former 180-degree yaw made muzzle/root dot -0.96.
-- New FBX geometry is authored with its pistol-grip pivot at the origin and
-- its muzzle along local -Z; keep the equipped assembly facing forward.
local R15_GRIP_YAW_DEGREES=0
local R15_GRIP_PITCH_DEGREES=16
local BASE_GRIP=CFrame.new(0,0.1,-0.3)
    *CFrame.Angles(math.rad(R15_GRIP_PITCH_DEGREES),0,0)
local HK416_MESH_SCALE=0.64
local HK416_SOURCE_REVISION="MeshyPBR-20261021"
-- Public Creator Store sounds. Availability still depends on experience permissions.
local FIRE_SOUND_ID="rbxassetid://9113189096"
local RELOAD_SOUND_ID="rbxassetid://8145744063"
local motorBases: {[Motor6D]: CFrame}={}

local function piece(tool: Tool,handle: Part,name: string,size: Vector3,
    offset: CFrame,color: Color3,material: Enum.Material?,shape: Enum.PartType?): Part
    local p=Instance.new("Part")
    p.Name=name
    p.Size=size
    p.CFrame=handle.CFrame*offset
    p.Color=color
    p.Material=material or Enum.Material.Metal
    if shape then p.Shape=shape end
    p.CanCollide=false
    p.CanTouch=false
    p.CanQuery=false
    p.Anchored=false
    p.Massless=true
    local w=Instance.new("WeldConstraint")
    w.Part0=handle
    w.Part1=p
    w.Parent=p
    p.Parent=tool
    return p
end
local function articulated(tool: Tool,handle: Part,name: string,size: Vector3,
    offset: CFrame): Motor6D
    local p=Instance.new("Part")
    p.Name=name
    p.Size=size
    p.CFrame=handle.CFrame*offset
    p.Material=Enum.Material.Metal
    p.Color=DARK
    p.CanCollide=false
    p.CanTouch=false
    p.CanQuery=false
    p.Anchored=false
    p.Massless=true
    p.Parent=tool
    local motor=Instance.new("Motor6D")
    motor.Name=name.."Joint"
    motor.Part0=handle
    motor.Part1=p
    motor.C0=offset
    motor.C1=CFrame.identity
    motor.Parent=handle
    motorBases[motor]=offset
    return motor
end
local function attachSound(handle: Part,name: string,id: string,volume: number)
    local s=Instance.new("Sound")
    s.Name=name
    s.SoundId=id
    s.Volume=volume
    s.RollOffMode=Enum.RollOffMode.InverseTapered
    s.RollOffMinDistance=15
    s.RollOffMaxDistance=220
    s.Parent=handle
end
local function playSound(handle: BasePart,name: string)
    local template=handle:FindFirstChild(name)
    if not template or not template:IsA("Sound") then return end
    local s=template:Clone()
    s.Name=name.."Playing"
    if name=="FireSound" then s.PlaybackSpeed=math.random(98,103)/100 end
    s.Parent=handle
    s:Play()
    Debris:AddItem(s,if name=="FireSound" then 4 else 3)
end
local function buildTool(): Tool
    local tool=Instance.new("Tool")
    tool.Name=Rules.DISPLAY_NAME
    tool.ToolTip="훈련 카빈 · 30발 · R 재장전"
    tool.RequiresHandle=true
    tool.CanBeDropped=false
    tool.Grip=BASE_GRIP
    tool:SetAttribute("WeaponId",Rules.WEAPON_ID)
    tool:SetAttribute("MagazineSize",Rules.MAGAZINE)
    tool:SetAttribute("UsingHK416Mesh",false)
    tool:SetAttribute("UsingR15SupportIK",false)
    tool:SetAttribute("UsingStableRifleMount",false)
    tool:SetAttribute("HK416ModelScale",HK416_MESH_SCALE)
    tool:SetAttribute("GripYawDegrees",R15_GRIP_YAW_DEGREES)
    tool:SetAttribute("GripPitchDegrees",R15_GRIP_PITCH_DEGREES)
    tool:SetAttribute("MeshSourceRevision",HK416_SOURCE_REVISION)
    tool:SetAttribute("MagazineFlipDegrees",0)
    tool:SetAttribute("MagazineTiltDegrees",15)
    local handle=Instance.new("Part")
    handle.Name="Handle"
    handle.Size=Vector3.new(0.29,0.32,0.89)
    handle.Color=STEEL
    handle.Material=Enum.Material.Metal
    handle.CanCollide=false
    handle.CanTouch=false
    handle.CanQuery=false
    handle.Massless=true
    handle.Parent=tool

    -- Mesh templates are imported by the developer via Studio's 3D importer.
    -- ServerStorage is deliberately NOT Rojo-managed; local mesh uploads remain
    -- in the game place even when the Lua source is re-synced.
    local assetFolder=ServerStorage:FindFirstChild("HK416Assets")
    local bodyAsset=if assetFolder then assetFolder:FindFirstChild("Body") else nil
    local magAsset=if assetFolder then assetFolder:FindFirstChild("Magazine") else nil
    local hasMeshes=assetFolder~=nil and assetFolder:GetAttribute("SourceRevision")==HK416_SOURCE_REVISION
        and bodyAsset~=nil and bodyAsset:IsA("MeshPart")
        and magAsset~=nil and magAsset:IsA("MeshPart")
    local mag: Motor6D
    local bolt: Motor6D
    if hasMeshes then
        tool:SetAttribute("UsingHK416Mesh",true)
        -- Templates preserve the new FBX UVs/PBR maps and normalized scale.
        -- Studio imports this FBX facing +Z; rotate geometry around Y so
        -- its barrel matches the -Z muzzle/IK/bolt coordinate system.
        handle.Transparency=1
        local body=(bodyAsset :: MeshPart):Clone()
        body.Name="HK416Body"
        body.Size=(bodyAsset :: MeshPart).Size*HK416_MESH_SCALE
        body.CFrame=handle.CFrame*CFrame.new(
            Vector3.new(-0.0106,0.5443,-1.2024)*HK416_MESH_SCALE)
            *CFrame.Angles(0,math.pi,0)
        body.Anchored=false
        body.CanCollide=false
        body.CanTouch=false
        body.CanQuery=false
        body.Massless=true
        body.Parent=tool
        local welded=Instance.new("WeldConstraint")
        welded.Part0=handle
        welded.Part1=body
        welded.Parent=body

        local magazine=(magAsset :: MeshPart):Clone()
        magazine.Name="Magazine"
        magazine.Size=(magAsset :: MeshPart).Size*HK416_MESH_SCALE
        -- The independently generated magazine faces opposite the body.
        -- Keep it upright and seat its feed lips inside the receiver magwell.
        -- Rotate around the inserted feed lips so the bottom leans toward
        -- the stock without opening a gap at the top of the magazine.
        local position=CFrame.new(Vector3.new(0,0.40,-1)*HK416_MESH_SCALE)
            *CFrame.Angles(math.rad(15),0,0)
            *CFrame.new(0,-0.63*HK416_MESH_SCALE,0)
        magazine.CFrame=handle.CFrame*position
        magazine.Anchored=false
        magazine.CanCollide=false
        magazine.CanTouch=false
        magazine.CanQuery=false
        magazine.Massless=true
        magazine.Parent=tool
        mag=Instance.new("Motor6D")
        mag.Name="MagazineJoint"
        mag.Part0=handle
        mag.Part1=magazine
        mag.C0=position
        mag.C1=CFrame.identity
        mag.Parent=handle
        motorBases[mag]=position
        -- The original body OBJ includes the bolt as one connected mesh, so
        -- use a modest overlay action piece rather than cutting its geometry.
        bolt=articulated(tool,handle,"Bolt",Vector3.new(0.08,0.10,0.28)*HK416_MESH_SCALE,
            CFrame.new(Vector3.new(0.28,0.72,-0.90)*HK416_MESH_SCALE))
    else
        -- Works immediately with Rojo even before the two assets are imported.
        local plastic=Enum.Material.SmoothPlastic
    local metal=Enum.Material.Metal
    local cylinder=Enum.PartType.Cylinder
    -- Higher-detail, symmetrical low-poly carbine model with optical sight.
    piece(tool,handle,"UpperReceiver",Vector3.new(0.40,0.33,0.93),CFrame.new(0,0.18,-0.08),STEEL,metal)
    piece(tool,handle,"LowerReceiver",Vector3.new(0.35,0.21,0.52),CFrame.new(0,-0.15,0.07),DARK,metal)
    piece(tool,handle,"Handguard",Vector3.new(0.44,0.38,0.95),CFrame.new(0,0.04,-0.95),OLIVE,plastic)
    for _,side in {-1,1} do
        for _,z in {-1.30,-1.05,-0.80} do
            piece(tool,handle,"Vent",Vector3.new(0.03,0.10,0.11),
                CFrame.new(side*0.24,0.03,z),DARK,metal)
        end
    end
    -- Cylinders' local Y axis is aligned with rifle local -Z.
    piece(tool,handle,"Barrel",Vector3.new(0.15,0.89,0.15),
        CFrame.new(0,0,-1.76)*CFrame.Angles(math.rad(-90),0,0),DARK,metal,cylinder)
    piece(tool,handle,"MuzzleBrake",Vector3.new(0.22,0.25,0.22),
        CFrame.new(0,0,-2.22)*CFrame.Angles(math.rad(-90),0,0),STEEL,metal,cylinder)
    piece(tool,handle,"SafetyTip",Vector3.new(0.23,0.085,0.23),
        CFrame.new(0,0,-2.38)*CFrame.Angles(math.rad(-90),0,0),ORANGE,metal,cylinder)
    piece(tool,handle,"TopRail",Vector3.new(0.23,0.09,1.78),CFrame.new(0,0.37,-0.49),DARK,metal)
    piece(tool,handle,"FrontSight",Vector3.new(0.12,0.25,0.13),CFrame.new(0,0.54,-1.56),DARK,metal)
    piece(tool,handle,"RearSight",Vector3.new(0.19,0.20,0.12),CFrame.new(0,0.52,0.18),DARK,metal)
    piece(tool,handle,"OpticMount",Vector3.new(0.26,0.13,0.36),CFrame.new(0,0.48,-0.37),STEEL,metal)
    piece(tool,handle,"ReflexSight",Vector3.new(0.36,0.24,0.30),CFrame.new(0,0.67,-0.37),DARK,metal)
    piece(tool,handle,"SightGlass",Vector3.new(0.20,0.15,0.035),
        CFrame.new(0,0.68,-0.53),Color3.fromRGB(65,123,144),Enum.Material.Glass)
    piece(tool,handle,"ChargingHandle",Vector3.new(0.39,0.12,0.15),CFrame.new(0,0.39,0.25),DARK,metal)
    piece(tool,handle,"TriggerGuard",Vector3.new(0.24,0.09,0.38),CFrame.new(0,-0.37,0.13),DARK,metal)
    piece(tool,handle,"PistolGrip",Vector3.new(0.28,0.62,0.27),
        CFrame.new(0,-0.54,0.35)*CFrame.Angles(math.rad(-16),0,0),OLIVE,plastic)
    piece(tool,handle,"StockTube",Vector3.new(0.18,0.18,0.91),CFrame.new(0,-0.03,0.98),STEEL,metal)
    piece(tool,handle,"Stock",Vector3.new(0.34,0.37,0.74),CFrame.new(0,-0.11,1.28),OLIVE,plastic)
    piece(tool,handle,"ShoulderPad",Vector3.new(0.41,0.55,0.14),CFrame.new(0,-0.16,1.72),DARK,plastic)
    piece(tool,handle,"SafetySelector",Vector3.new(0.06,0.10,0.17),CFrame.new(0.20,0,0.20),ORANGE,metal)
    piece(tool,handle,"MagCollar",Vector3.new(0.34,0.10,0.36),CFrame.new(0,-0.34,-0.24),STEEL,metal)
    mag=articulated(tool,handle,"Magazine",Vector3.new(0.32,0.73,0.33),
        CFrame.new(0,-0.68,-0.21)*CFrame.Angles(math.rad(12),0,0))
    bolt=articulated(tool,handle,"Bolt",Vector3.new(0.08,0.11,0.37),CFrame.new(0.24,0.18,-0.18))
    local port=piece(tool,handle,"EjectionPort",Vector3.new(0.012,0.14,0.42),
        CFrame.new(0.216,0.16,-0.13),DARK,metal)
    port.Transparency=0.1
    end

    -- Both IK targets follow the gun. The support hand rests on the handguard;
    -- while reloading it reaches for the magazine, which moves on Motor6D.
    local support=Instance.new("Attachment")
    support.Name="SupportHandTarget"
    support.Position=if hasMeshes
        then Vector3.new(-0.20,0.40,-2.40)*HK416_MESH_SCALE
        else Vector3.new(-0.20,-0.07,-0.95)
    support.Parent=handle
    local magazinePart=mag.Part1
    if magazinePart then
        local reloadHand=Instance.new("Attachment")
        reloadHand.Name="MagazineHandTarget"
        reloadHand.Position=if hasMeshes
            then Vector3.new(-0.15,0.21,0)*HK416_MESH_SCALE
            else Vector3.new(-0.15,0.21,0)
        reloadHand.Parent=magazinePart
    end

    local muzzle=Instance.new("Attachment")
    muzzle.Name="Muzzle"
    local meshBody=tool:FindFirstChild("HK416Body")
    if hasMeshes and meshBody and meshBody:IsA("MeshPart") then
        -- Measured from the FBX muzzle's terminal ring, relative to mesh center.
        -- The imported body points along +Z; Front (-Z) needs a half-turn.
        muzzle.CFrame=CFrame.new(Vector3.new(0.04483,0.32258,2.88072)*HK416_MESH_SCALE)
            *CFrame.Angles(0,math.pi,0)
        muzzle.Parent=meshBody
    else
        muzzle.Position=Vector3.new(0,0,-2.47)
        muzzle.Parent=handle
    end
    local spark=Instance.new("ParticleEmitter")
    spark.Name="MuzzleFlash"
    spark.Enabled=false
    spark.EmissionDirection=Enum.NormalId.Front
    spark.LockedToPart=true
    spark.Rate=0
    spark.Texture="rbxasset://textures/particles/sparkles_main.dds"
    spark.Lifetime=NumberRange.new(0.04,0.10)
    spark.Speed=NumberRange.new(2,6)
    spark.Size=NumberSequence.new(0.23,0)
    spark.Color=ColorSequence.new(Color3.fromRGB(255,219,147),Color3.fromRGB(255,121,44))
    spark.SpreadAngle=Vector2.new(35,35)
    spark.LightEmission=1
    spark.Parent=muzzle
    local light=Instance.new("PointLight")
    light.Name="FlashLight"
    light.Color=Color3.fromRGB(255,200,110)
    light.Range=10
    light.Brightness=2.8
    light.Enabled=false
    light.Parent=muzzle
    attachSound(handle,"FireSound",FIRE_SOUND_ID,0.8)
    attachSound(handle,"ReloadSound",RELOAD_SOUND_ID,0.72)

    local state=Rules.new(true)
    tool:SetAttribute("UnlimitedReserve",true)
    sessions[tool]=state
    tool:SetAttribute("Ammo",state.ammo)
    tool:SetAttribute("Reserve",state.reserve)
    tool:SetAttribute("Reloading",false)
    tool.Destroying:Connect(function()
        sessions[tool]=nil
        motorBases[mag]=nil
        motorBases[bolt]=nil
    end)
    return tool
end
local function publish(tool: Tool,state: Rules.WeaponState)
    tool:SetAttribute("Ammo",state.ammo)
    tool:SetAttribute("Reserve",state.reserve)
    tool:SetAttribute("Reloading",state.reloadUntil&gt;0)
end
local function animateBolt(handle: BasePart)
    local joint=handle:FindFirstChild("BoltJoint")
    if not joint or not joint:IsA("Motor6D") then return end
    local base=motorBases[joint]
    if not base then return end
    local weapon=handle.Parent
    local scale=if weapon and weapon:IsA("Tool") and weapon:GetAttribute("UsingHK416Mesh")==true
        then HK416_MESH_SCALE else 1
    joint.C0=base*CFrame.new(0,0,0.17*scale)
    TweenService:Create(joint,TweenInfo.new(0.12,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{C0=base}):Play()
end
local function animateMag(handle: BasePart)
    local joint=handle:FindFirstChild("MagazineJoint")
    if not joint or not joint:IsA("Motor6D") then return end
    local base=motorBases[joint]
    if not base then return end
    local weapon=handle.Parent
    local scale=if weapon and weapon:IsA("Tool") and weapon:GetAttribute("UsingHK416Mesh")==true
        then HK416_MESH_SCALE else 1
    -- Translate in receiver space so reload always extracts downward.
    local translated=CFrame.new(0,-0.64*scale,-0.12*scale)*base
    TweenService:Create(joint,TweenInfo.new(0.29,Enum.EasingStyle.Quad),{
        C0=translated*CFrame.Angles(math.rad(11),0,0)}):Play()
    task.delay(0.96,function()
        if joint.Parent then
            TweenService:Create(joint,TweenInfo.new(0.41,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{C0=base}):Play()
        end
    end)
end
local function makeTracer(from: Vector3,to: Vector3,shooterId: number)
    local length=(to-from).Magnitude
    if length&lt;0.1 then return end
    local p=Instance.new("Part")
    p.Name="TrainingRifleTracer"
    p:SetAttribute("ShooterUserId",shooterId)
    p.Anchored=true
    p.CanCollide=false
    p.CanTouch=false
    p.CanQuery=false
    p.Material=Enum.Material.Neon
    p.Transparency=0.35
    p.Color=Color3.fromRGB(251,202,130)
    p.Size=Vector3.new(0.045,0.045,length)
    p.CFrame=CFrame.lookAt(from,to)*CFrame.new(0,0,-length/2)
    p.Parent=workspace
    Debris:AddItem(p,0.075)
end
local function fire(player: Player,tool: Tool,state: Rules.WeaponState,aimPoint: any)
    if typeof(aimPoint)~="Vector3" then return end
    if aimPoint.X~=aimPoint.X or aimPoint.Y~=aimPoint.Y or aimPoint.Z~=aimPoint.Z
        or math.max(math.abs(aimPoint.X),math.abs(aimPoint.Y),math.abs(aimPoint.Z))&gt;100000 then return end
    local character=player.Character
    if not character or tool.Parent~=character then return end
    local head=character:FindFirstChild("Head")
    local root=character:FindFirstChild("HumanoidRootPart")
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if not head or not head:IsA("BasePart") or not root or not root:IsA("BasePart")
        or not humanoid or humanoid.Health&lt;=0 then return end
    local handle=tool:FindFirstChild("Handle")
    local muzzle=tool:FindFirstChild("Muzzle",true)
    if not handle or not handle:IsA("BasePart") or not muzzle or not muzzle:IsA("Attachment") then return end
    local origin=muzzle.WorldPosition
    if (origin-head.Position).Magnitude&gt;8 then return end
    local toAim=(aimPoint :: Vector3)-origin
    if toAim.Magnitude&lt;0.5 then return end
    local direction=toAim.Unit
    -- Forward hemisphere check prevents backwards/behind-the-head exploit shots.
    local facing=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
    local heading=Vector3.new(direction.X,0,direction.Z)
    if facing.Magnitude&gt;0.1 and heading.Magnitude&gt;0.1
        and facing.Unit:Dot(heading.Unit)&lt;-0.45 then return end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character}
    params.IgnoreWater=true
    local bridge=origin-head.Position
    if bridge.Magnitude&gt;0.1 and workspace:Raycast(head.Position,bridge,params) then return end
    if not Rules.tryFire(state,os.clock()) then return end
    publish(tool,state)
    playSound(handle,"FireSound")
    animateBolt(handle)
    local spark=muzzle:FindFirstChild("MuzzleFlash")
    if spark and spark:IsA("ParticleEmitter") then spark:Emit(7) end
    local light=muzzle:FindFirstChild("FlashLight")
    if light and light:IsA("PointLight") then
        light.Enabled=true
        task.delay(0.07,function() if light.Parent then light.Enabled=false end end)
    end
    local result=workspace:Raycast(origin,direction*Rules.RANGE,params)
    local hitPoint=if result then result.Position else origin+direction*Rules.RANGE
    makeTracer(origin,hitPoint,player.UserId)
    remote:FireClient(player,"shot",tool,hitPoint)
    if not result then return end
    local model=result.Instance:FindFirstAncestorOfClass("Model")
    local victim=if model then model:FindFirstChildOfClass("Humanoid") else nil
    if not victim or victim.Health&lt;=0 or victim==humanoid then return end
    local target=Players:GetPlayerFromCharacter(model :: Model)
    if target and player.Team and not player.Neutral and target.Team==player.Team and not target.Neutral then return end
    victim:TakeDamage(Rules.DAMAGE)
end
local function reload(tool: Tool,state: Rules.WeaponState)
    if not Rules.startReload(state,os.clock()) then return end
    publish(tool,state)
    local handle=tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        playSound(handle,"ReloadSound")
        animateMag(handle)
    end
    task.delay(Rules.RELOAD_SECONDS+0.04,function()
        if sessions[tool]~=state or not tool.Parent then return end
        if Rules.completeReload(state,os.clock()) then publish(tool,state) end
    end)
end
remote.OnServerEvent:Connect(function(player: Player,action: any,aimPoint: any)
    if type(action)~="string" or #action&gt;12 then return end
    local now=os.clock()
    if now-(lastRemote[player] or -math.huge)&lt;0.045 then return end
    lastRemote[player]=now
    -- A copied Tool/client attribute cannot grant a purchase entitlement.
    if not access.allowed(player.UserId) then return end
    local character=player.Character
    local tool=if character then character:FindFirstChild(Rules.DISPLAY_NAME) else nil
    if not tool or not tool:IsA("Tool") or tool:GetAttribute("WeaponId")~=Rules.WEAPON_ID then return end
    local state=sessions[tool]
    if not state then return end
    if action=="fire" then
        fire(player,tool,state,aimPoint)
    elseif action=="reload" then
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health&gt;0 then reload(tool,state) end
    end
end)
-- Fix the weapon to the torso; IK makes both hands follow the weapon instead
-- of allowing the walk/tool arm animations to drag its muzzle around.
-- R6 retains Roblox's normal grip and the existing client shoulder fallback.
local function configureR15IK(tool: Tool,character: Model)
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.RigType~=Enum.HumanoidRigType.R15 then return end
    local handle=tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return end
    local rest=handle:FindFirstChild("SupportHandTarget")
    local magazine=tool:FindFirstChild("Magazine")
    local loading=if magazine then magazine:FindFirstChild("MagazineHandTarget") else nil
    if not rest or not rest:IsA("Attachment") then return end

    local active: IKControl?=nil
    local rightControl: IKControl?=nil
    local rightTarget: Attachment?=nil
    local mount: Motor6D?=nil
    local defaultGrip: JointInstance?=nil
    local gripWasEnabled=true
    local equipVersion=0
    local function release()
        equipVersion+=1
        if active then active:Destroy();active=nil end
        if rightControl then rightControl:Destroy();rightControl=nil end
        if mount then mount:Destroy();mount=nil end
        if rightTarget then rightTarget:Destroy();rightTarget=nil end
        if defaultGrip and defaultGrip.Parent then defaultGrip.Enabled=gripWasEnabled end
        defaultGrip=nil
        tool:SetAttribute("UsingR15SupportIK",false)
        tool:SetAttribute("UsingStableRifleMount",false)
    end
    tool.Equipped:Connect(function()
        release()
        local version=equipVersion
        -- Client-owned R15 animation can reach the server after Equipped.
        -- Wait for the actual forward hold pose, never freeze the spawn pose
        -- with the arm dangling down. The bounded wait cancels on unequip.
        task.spawn(function()
            local ready=false
            for attempt=1,80 do
                if version~=equipVersion or tool.Parent~=character or humanoid.Health&lt;=0 then return end
                local root=character:FindFirstChild("HumanoidRootPart")
                local hand=character:FindFirstChild("RightHand")
                local grip=if hand then hand:FindFirstChild("RightGrip") else nil
                if attempt&gt;=4 and grip and grip:IsA("JointInstance") and grip.Part1==handle
                    and root and root:IsA("BasePart")
                    and handle.CFrame.LookVector:Dot(root.CFrame.LookVector)&gt;0.85
                    and handle.CFrame.UpVector.Y&gt;0.75 then
                    ready=true
                    break
                end
                task.wait(0.05)
            end
            if not ready then return end
            local torso=character:FindFirstChild("UpperTorso")
            local leftUpper=character:FindFirstChild("LeftUpperArm")
            local leftHand=character:FindFirstChild("LeftHand")
            local rightUpper=character:FindFirstChild("RightUpperArm")
            local rightHand=character:FindFirstChild("RightHand")
            if not torso or not torso:IsA("BasePart")
                or not leftUpper or not leftUpper:IsA("BasePart")
                or not leftHand or not leftHand:IsA("BasePart")
                or not rightUpper or not rightUpper:IsA("BasePart")
                or not rightHand or not rightHand:IsA("BasePart") then return end
            local grip=rightHand:FindFirstChild("RightGrip")
            if not grip or not grip:IsA("JointInstance") or grip.Part1~=handle then return end

            local target=Instance.new("Attachment")
            target.Name="TriggerHandTarget"
            target.CFrame=handle.CFrame:ToObjectSpace(rightHand.CFrame)
            target.Parent=handle
            rightTarget=target
            local joint=Instance.new("Motor6D")
            joint.Name="RifleHoldJoint"
            joint.Part0=torso
            joint.Part1=handle
            -- Server animation replication can lag the owning client's arm.
            -- Keep the fitted grip position, with a level forward rifle frame.
            local root=character:FindFirstChild("HumanoidRootPart")
            if not root or not root:IsA("BasePart") then target:Destroy();rightTarget=nil;return end
            local held=CFrame.lookAt(handle.Position,
                handle.Position+root.CFrame.LookVector,root.CFrame.UpVector)
            joint.C0=torso.CFrame:ToObjectSpace(held)
            joint.C1=CFrame.identity
            joint:SetAttribute("RestC0",joint.C0)
            defaultGrip=grip
            gripWasEnabled=grip.Enabled
            grip.Enabled=false
            joint.Parent=handle
            mount=joint

            local right=Instance.new("IKControl")
            right.Name="TrainingRifleRightHandIK"
            right.Type=Enum.IKControlType.Transform
            right.ChainRoot=rightUpper
            right.EndEffector=rightHand
            right.Target=target
            right.SmoothTime=0
            right.Priority=20
            right.Weight=1
            right.Parent=humanoid
            rightControl=right

            local left=Instance.new("IKControl")
            left.Name="TrainingRifleLeftHandIK"
            left.Type=Enum.IKControlType.Position
            left.ChainRoot=leftUpper
            left.EndEffector=leftHand
            left.Target=if tool:GetAttribute("Reloading")==true and loading then loading else rest
            left.SmoothTime=0
            left.Priority=10
            left.Weight=1
            left.Parent=humanoid
            active=left
            tool:SetAttribute("UsingR15SupportIK",true)
            tool:SetAttribute("UsingStableRifleMount",true)
        end)
    end)
    tool.Unequipped:Connect(release)
    tool.Destroying:Connect(release)
    humanoid.Died:Connect(release)
    tool:GetAttributeChangedSignal("Reloading"):Connect(function()
        if active and active.Parent then
            active.Target=if tool:GetAttribute("Reloading")==true and loading then loading else rest
        end
    end)
end

local function grant(player: Player,character: Model)
    task.spawn(function()
        local owns,status=access.check(player.UserId)
        if player.Parent~=Players or player.Character~=character then return end
        if status~="checking" then
            player:SetAttribute("TrainingRifleOwned",owns)
            player:SetAttribute("TrainingRifleOwnershipStatus",status)
        end
        if not owns then return end
        local backpack=player:WaitForChild("Backpack",10)
        if player.Parent~=Players or player.Character~=character or not backpack
            or not access.allowed(player.UserId) then return end
        if backpack:FindFirstChild(Rules.DISPLAY_NAME) or character:FindFirstChild(Rules.DISPLAY_NAME) then return end
        local tool=buildTool()
        configureR15IK(tool,character)
        if player.Parent==Players and player.Character==character then tool.Parent=backpack
        else tool:Destroy() end
    end)
end
local function refreshAccess(player: Player)
    task.spawn(function()
        local owns,status=access.check(player.UserId,true)
        if player.Parent~=Players or status=="checking" then return end
        player:SetAttribute("TrainingRifleOwned",owns)
        player:SetAttribute("TrainingRifleOwnershipStatus",status)
        if owns then
            if player.Character then grant(player,player.Character) end
        else
            -- Ownership lookup failed or the pass is no longer owned.
            for _,container in {player:FindFirstChild("Backpack"),player.Character} do
                if container then
                    for _,child in container:GetChildren() do
                        if child:IsA("Tool") and child:GetAttribute("WeaponId")==Rules.WEAPON_ID then
                            child:Destroy()
                        end
                    end
                end
            end
        end
    end)
end
local function add(player: Player)
    player:SetAttribute("TrainingRifleOwned",false)
    player:SetAttribute("TrainingRifleOwnershipStatus","checking")
    player.CharacterAdded:Connect(function(character: Model) grant(player,character) end)
    if player.Character then grant(player,player.Character) end
end
Players.PlayerAdded:Connect(add)
Players.PlayerRemoving:Connect(function(player)
    lastRemote[player]=nil
    access.forget(player.UserId)
end)
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player,passId: number,purchased: boolean)
    if purchased and passId==PurchaseConfig.GAME_PASS_ID
        and PassAccess.validPassId(passId) and player.Parent==Players then
        refreshAccess(player)
    end
end)
for _,player in Players:GetPlayers() do add(player) end
task.spawn(function()
    while task.wait(30) do
        for _,player in Players:GetPlayers() do refreshAccess(player) end
    end
end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="MessengerSync6"><Properties><string name="Name">RiflePassAccess</string><ProtectedString name="Source">--!strict
-- Pure server entitlement cache; the Marketplace lookup is injected for tests.
local Access={}
export type Status="owned"|"notOwned"|"unconfigured"|"error"|"checking"
export type Entry={owns: boolean,untilTime: number,status: Status}
export type Options={
    passId: number,
    lookup: (number,number)-&gt;boolean,
    clock: ()-&gt;number,
    cacheSeconds: number,
    retrySeconds: number,
}
function Access.validPassId(value: number): boolean
    return value==value and value&gt;0 and value&lt;math.huge and value%1==0
end
function Access.new(options: Options)
    local cache: {[number]: Entry}={}
    local pending: {[number]: boolean}={}
    local versions: {[number]: number}={}
    local service={}
    function service.allowed(userId: number): boolean
        if not Access.validPassId(options.passId) then return false end
        local entry=cache[userId]
        return entry~=nil and entry.owns and options.clock()&lt;entry.untilTime
    end
    function service.check(userId: number,force: boolean?): (boolean,Status)
        if not Access.validPassId(options.passId) then return false,"unconfigured" end
        local entry=cache[userId]
        if not force and entry and options.clock()&lt;entry.untilTime then
            return entry.owns,entry.status
        end
        if pending[userId] then return false,"checking" end
        pending[userId]=true
        local version=versions[userId] or 0
        local success,result=pcall(options.lookup,userId,options.passId)
        -- Leaving a server invalidates any lookup that was already in flight.
        if (versions[userId] or 0)~=version then return false,"checking" end
        pending[userId]=nil
        local owns=success and result==true
        local status: Status=if not success or type(result)~="boolean" then "error"
            elseif owns then "owned" else "notOwned"
        cache[userId]={owns=owns,status=status,untilTime=options.clock()
            +(if status=="error" then options.retrySeconds else options.cacheSeconds)}
        return owns,status
    end
    function service.forget(userId: number)
        versions[userId]=(versions[userId] or 0)+1
        cache[userId]=nil
        pending[userId]=nil
    end
    return service
end
return Access
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync7"><Properties><string name="Name">TrainingRiflePurchaseConfig</string><ProtectedString name="Source">--!strict
-- Set this to this experience's HK416 Game Pass ID (not a developer product ID).
-- Zero keeps the weapon locked until the real purchase entitlement is configured.
return table.freeze({
    GAME_PASS_ID = 2045534768,
    OWNERSHIP_CACHE_SECONDS = 60,
    ERROR_RETRY_SECONDS = 5,
})
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync8"><Properties><string name="Name">ServerLogHistory</string><ProtectedString name="Source">--!strict
-- Each service instance belongs to one server process and starts empty.
local History={}
function History.new()
    local entries: {[string]: {any}}={chat={},command={}}
    local sequence=0
    local store={}
    function store.append(entry: any)
        sequence+=1
        entry.sequence=sequence
        table.insert(entries[entry.kind],entry)
    end
    function store.page(kind: string,before: number?,limit: number): ({any},number,boolean)
        local ceiling=before or math.huge
        local items={}
        local cursor=ceiling
        local list=entries[kind]
        for i=#list,1,-1 do
            local entry=list[i]
            if entry.sequence&lt;ceiling then
                if #items&gt;=limit then return items,cursor,true end
                table.insert(items,entry)
                cursor=entry.sequence
            end
        end
        return items,cursor,false
    end
    return store
end
return History
</ProtectedString></Properties></Item></Item>
