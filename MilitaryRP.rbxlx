		<Item class="Script" referent="RBX11">
			<Properties>
				<ProtectedString name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Rules = require(ReplicatedStorage.Shared:WaitForChild("Rules"))
local Sessions = require(script.Parent:WaitForChild("Sessions"))
local Combat = require(script.Parent:WaitForChild("Combat"))
Players.RespawnTime = 4
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
local events: {[string]: RemoteEvent} = {}
for _, name in {"Fire", "Reload", "JoinTeam", "JoinSquad"} do
    local event = Instance.new("RemoteEvent")
    event.Name = name; event.Parent = remotes; events[name] = event
end
local teamObjects: {[string]: Team} = {}
local spawns: {[string]: SpawnLocation} = {}
local fixture = Instance.new("Folder")
fixture.Name = "MVPFixtures"; fixture.Parent = workspace
local function part(name: string, size: Vector3, position: Vector3, color: Color3): Part
    local p = Instance.new("Part")
    p.Name=name; p.Anchored=true; p.Size=size; p.Position=position; p.Color=color; p.Parent=fixture
    return p
end
part("TestFloor",Vector3.new(200,1,240),Vector3.new(0,-0.5,0),Color3.fromRGB(65,76,64))
-- Temporary test fixtures only; these can be replaced by a map later.
for _, spec in {
    {"Training","훈련병","Bright green",Vector3.new(0,1,90)},
    {"Blue","청군","Bright blue",Vector3.new(-50,1,-45)},
    {"Red","홍군","Bright red",Vector3.new(50,1,-45)},
} do
    local t=Instance.new("Team")
    t.Name=spec[2] :: string; t.TeamColor=BrickColor.new(spec[3] :: string); t.AutoAssignable=false; t.Parent=Teams
    teamObjects[spec[1] :: string]=t
    local spawn=Instance.new("SpawnLocation")
    spawn.Name=spec[1] :: string; spawn.Anchored=true; spawn.Size=Vector3.new(10,1,10)
    spawn.Position=spec[4] :: Vector3; spawn.Neutral=false; spawn.TeamColor=t.TeamColor
    spawn.AllowTeamChangeOnTouch=false; spawn.Duration=3; spawn.Parent=fixture
    spawns[spec[1] :: string]=spawn
end
local targets=Instance.new("Folder"); targets.Name="TrainingTargets"; targets.Parent=fixture
for i=1,5 do
    local p=part("Target"..i,Vector3.new(4,6,1),Vector3.new((i-3)*10,4,60),Color3.fromRGB(245,193,63))
    p.Parent=targets
end
-- Separate range from combat; prevents shooting range targets from the combat area.
part("RangeDivider",Vector3.new(200,18,2),Vector3.new(0,9,30),Color3.fromRGB(91,97,90))
local round: any = {phase="Intermission",scores={Blue=0,Red=0},endsAt=0}
round.publish=function()
    ReplicatedStorage:SetAttribute("RoundPhase",round.phase)
    ReplicatedStorage:SetAttribute("BlueScore",round.scores.Blue)
    ReplicatedStorage:SetAttribute("RedScore",round.scores.Red)
    ReplicatedStorage:SetAttribute("RoundEndsAt",round.endsAt)
end
local function characterReady(player: Player, character: Model)
    Sessions.resetWeapon(player)
    local humanoid=character:WaitForChild("Humanoid",10)
    if player.Character ~= character or not humanoid or not humanoid:IsA("Humanoid") then return end
    humanoid.Died:Connect(function()
        if player.Character == character then Sessions.resetWeapon(player) end
    end)
    local backpack=player:WaitForChild("Backpack",10)
    if player.Character ~= character or humanoid.Health <= 0 or not backpack then return end
    local tool=Instance.new("Tool")
    tool.Name="ServiceRifle"; tool.ToolTip="제식소총 · 클릭 사격 / R 재장전"
    tool.RequiresHandle=false; tool.CanBeDropped=false; tool:SetAttribute("ServerIssued",true)
    tool.Parent=backpack
end
local function addPlayer(player: Player)
    if Sessions.get(player) then return end
    Sessions.add(player)
    player.Team=teamObjects.Training; player.Neutral=false; player.RespawnLocation=spawns.Training
    player.CharacterAdded:Connect(function(c) characterReady(player,c) end)
    if player.Character then task.spawn(characterReady,player,player.Character) end
end
Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(Sessions.remove)
for _, player in Players:GetPlayers() do addPlayer(player) end
local function respawn(player: Player)
    task.spawn(function()
        local ok, err=pcall(function() player:LoadCharacterAsync() end)
        if not ok and player.Parent == Players then warn("Respawn failed",err) end
    end)
end
local function alive(player: Player): boolean
    local c=player.Character
    local h=if c then c:FindFirstChildOfClass("Humanoid") else nil
    return h ~= nil and h.Health > 0
end
events.JoinTeam.OnServerEvent:Connect(function(player: Player, requested: any)
    if not Sessions.allow(player,"team",1,2) then return end
    local s=Sessions.get(player)
    if not s or requested == s.team or not alive(player) then return end
    if os.clock()-s.lastTeamChange < Config.TeamChangeCooldown then return end
    -- Battle allegiance is locked during a round; trainees can deploy once.
    if s.team ~= "Training" and round.phase == "Active" then return end
    if requested ~= "Blue" and requested ~= "Red" then return end
    local other=if requested == "Blue" then "Red" else "Blue"
    local otherCount=Sessions.count(other)-(if s.team == other then 1 else 0)
    if not Rules.canJoin(s.trained,requested,Sessions.count(requested),otherCount) then return end
    s.team=requested; s.squad=0; s.lastTeamChange=os.clock()
    player.Team=teamObjects[requested]; player.RespawnLocation=spawns[requested]
    Sessions.publish(player); respawn(player)
end)
events.JoinSquad.OnServerEvent:Connect(function(player: Player, requested: any)
    if not Sessions.allow(player,"squad",1,2) then return end
    local s=Sessions.get(player)
    if not s or s.team == "Training" or type(requested) ~= "number" then return end
    if requested ~= 1 and requested ~= 2 and requested ~= 3 then return end
    if s.squad == requested or Sessions.count(s.team,requested) >= Config.SquadCapacity then return end
    s.squad=requested; Sessions.publish(player)
end)
events.Fire.OnServerEvent:Connect(function(player: Player, direction: any) Combat.fire(player,direction,round,targets) end)
events.Reload.OnServerEvent:Connect(Combat.reload)
remotes.Parent=ReplicatedStorage -- Expose only after all handlers are connected.
task.spawn(function()
    while true do
        round.phase="Intermission"; round.endsAt=workspace:GetServerTimeNow()+Config.IntermissionSeconds
        round.publish()
        task.wait(Config.IntermissionSeconds)
        round.scores={Blue=0,Red=0}; round.phase="Active"
        round.endsAt=workspace:GetServerTimeNow()+Config.RoundSeconds
        for _, player in Players:GetPlayers() do
            local s=Sessions.get(player)
            if s and s.team ~= "Training" then respawn(player) end
        end
        round.publish()
        repeat task.wait(0.25) until workspace:GetServerTimeNow() >= round.endsAt
            or round.scores.Blue >= Config.ScoreLimit or round.scores.Red >= Config.ScoreLimit
        local winner=if round.scores.Blue == round.scores.Red then "Draw"
            elseif round.scores.Blue > round.scores.Red then "Blue" else "Red"
        ReplicatedStorage:SetAttribute("LastWinner",winner)
    end
end)
]]></ProtectedString>
