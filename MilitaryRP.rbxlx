    state.reloadUntil=0
    return true
end
return table.freeze(Rules)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync14"><Properties><string name="Name">CommandHelpCatalog</string><ProtectedString name="Source">--!strict
-- Display-only command reference. Never use this table to grant privileges.
-- Actual execution always goes through the server's group-rank checks.
local Catalog = {
    Sections = {
        {
            title = "계급 · 팀",
            entries = {
                {syntax = ";계급 나 대위  /  ;rank 나 captain", description = "내 계급 변경. 플레이어 이름을 넣으면 대상을 변경합니다."},
                {syntax = ";계급 대상 admin  /  ;rank 대상 admin", description = "대상에게 실제 admin 계급을 저장하면 HQ 팀으로 자동 배정됩니다."},
                {syntax = ";계급목록  /  ;ranks", description = "사용 가능한 계급 목록을 채팅에 표시합니다."},
                {syntax = ";팀 대상 본부  /  ;team 대상 본부", description = "대상을 지정한 팀으로 이동. 본부 등 7개 팀을 지원합니다."},
            },
        },
        {
            title = "운영진 제어",
            entries = {
                {syntax = ";무적 대상 켜기  /  ;god 대상 on", description = "무적 켜기·끄기 (끄기 또는 off)."},
                {syntax = ";비행 대상 켜기  /  ;fly 대상 on", description = "비행 켜기·끄기 (끄기 또는 off)."},
                {syntax = ";to 대상", description = "내가 대상 플레이어 옆으로 순간이동합니다."},
                {syntax = ";here 대상", description = "대상 플레이어를 내 위치로 소환합니다."},
                {syntax = ";kill 대상", description = "대상 플레이어를 사망 처리합니다."},
                {syntax = ";폭발 대상  /  ;explode 대상", description = "폭발 효과와 함께 대상 플레이어를 사망 처리합니다."},
            },
        },
        {
            title = "도움말",
            entries = {
                {syntax = ";?  /  ;help", description = "지금 보고 있는 명령어 안내창을 엽니다."},
            },
        },
    },
}
return table.freeze(Catalog)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync15"><Properties><string name="Name">FlightControlsRules</string><ProtectedString name="Source">--!strict
-- A cosmetic flight control is visible only while the SERVER considers this
-- player to be flying and the compact-screen UI is not covering game controls.
local Rules={}
function Rules.visible(adminFlying: any,hiddenByModal: any): boolean
    return adminFlying==true and hiddenByModal~=true
end
return table.freeze(Rules)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync16"><Properties><string name="Name">MobileUIRules</string><ProtectedString name="Source">--!strict
-- Shared UI density rules for mobile + small emulated viewports.
-- Pair UIScale with a larger logical frame so every input, label and spacing
-- shrinks proportionally while scrollable content retains its full extent.
local Rules={}
function Rules.forViewport(width: number,height: number,touch: boolean): any
    local compact=width&lt;900 or height&lt;580
    local cramped=width&lt;480 or height&lt;440
    local scale: number
    if compact and cramped then
        scale=if touch then 0.82 else 0.86
    elseif compact then
        scale=0.90
    elseif touch then
        scale=0.92
    else
        scale=1
    end
    return {
        compact=compact,
        scale=scale,
        widthCoverage=if compact then 0.92 else 0.94,
        heightCoverage=if compact then 0.88 else 0.94,
    }
end
-- Return the opening animation's start and END scale together. This keeps
-- the target proportional to the current screen instead of resetting to 1.
function Rules.openingScales(width: number,height: number,touch: boolean): (number,number)
    local target=Rules.forViewport(width,height,touch).scale
    return target*0.94,target
end
return table.freeze(Rules)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync22"><Properties><string name="Name">KatanaRules</string><ProtectedString name="Source">--!strict
-- Pure state and combat geometry policy; no Roblox services required.
local Rules={WEAPON_ID="Katana",DISPLAY_NAME="카타나",DAMAGE=30,COOLDOWN=.65,
    DRAW_SECONDS=.35,WINDUP=.14,ACTIVE_SECONDS=.18,RANGE=5.5,MIN_DOT=.30,MAX_VERTICAL=3.5}
export type State={lastSwing: number,readyAt: number,serial: number}
local function finite(n: number): boolean return n==n and math.abs(n)&lt;math.huge end
function Rules.new(): State return {lastSwing=-math.huge,readyAt=math.huge,serial=0} end
function Rules.equip(state: State,now: number)
    state.serial+=1
    state.readyAt=now+Rules.DRAW_SECONDS
end
function Rules.unequip(state: State)
    state.serial+=1
    state.readyAt=math.huge
end
function Rules.trySwing(state: State,now: number): boolean
    if not finite(now) or now&lt;state.readyAt or now-state.lastSwing&lt;Rules.COOLDOWN then return false end
    state.lastSwing=now
    state.serial+=1
    return true
end
function Rules.inReach(distance: number,dot: number,vertical: number): boolean
    return finite(distance) and finite(dot) and finite(vertical) and distance&gt;=0
        and distance&lt;=Rules.RANGE and dot&gt;=Rules.MIN_DOT and math.abs(vertical)&lt;=Rules.MAX_VERTICAL
end
function Rules.canDamage(isSelf: boolean,sameTeam: boolean,attackerNeutral: boolean,targetNeutral: boolean): boolean
    return not isSelf and not (sameTeam and not attackerNeutral and not targetNeutral)
end
return table.freeze(Rules)
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync25"><Properties><string name="Name">ExamPlacementRules</string><ProtectedString name="Source">--!strict
-- Bounded editor settings. Missing attributes keep legacy point behavior.
local Placement={}
function Placement.spacing(value: any): number
    if type(value)~="number" or value~=value or math.abs(value)==math.huge then return 4 end
    return math.clamp(value,3,10)
end
function Placement.height(value: any): number
    if type(value)~="number" or value~=value or math.abs(value)==math.huge then return 0 end
    return math.clamp(value,0,20)
end
return table.freeze(Placement)
</ProtectedString></Properties></Item></Item>
