			<Properties>
				<ProtectedString name="Source">--!strict
-- All messenger channels use the same server ACL and TextChatService pipeline.
require(script.Parent:WaitForChild("MessengerRuntime")).start()
</ProtectedString>
				<bool name="Disabled">false</bool>
				<Content name="LinkedSource"><null /></Content>
				<token name="RunContext">0</token>
				<string name="ScriptGuid">{0e92c435-763e-4e60-8673-85d29f3c39ed}</string>
				<BinaryString name="AttributesSerialize" />
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">MilitaryMessenger</string>
				<BinaryString name="SerializedOverrides" />
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">01d403e696a9a5530ae7b2b000001929</UniqueId>
			</Properties>
		</Item>
	<Item class="Script" referent="MessengerSync1"><Properties><string name="Name">MessengerManagement</string><ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local HttpService=game:GetService("HttpService")
local Store=require(script.Parent.MessengerStore)
local Rules=require(script.Parent.MessengerState)
local Permissions=require(script.Parent.MessengerPermissions)
local Runtime=require(script.Parent.MessengerRuntime)
Runtime.start()
local remote=Instance.new("RemoteFunction");remote.Name="MessengerManage";remote.Parent=ReplicatedStorage
local changed=Instance.new("RemoteEvent");changed.Name="MessengerChannelsChanged";changed.Parent=ReplicatedStorage
local last={}
local editing={}
local metadataLast={}
local function snapshot(actor: Player)
    local data=Store.get()
    local result={channels={},permissions={roles={},people={},ownerId=Rules.OWNER},storage=Store.status(),revision=data.revision,
        canCreate=Permissions.has(actor,"CREATE_CHANNELS"),canManageRoles=Permissions.has(actor,"MANAGE_ROLES")}
    if not result.storage.ready then return result end
    for id,entry in data.channels do
        local read=Permissions.channel(actor,id,"read")
        local manage=Permissions.channel(actor,id,"manage")
        if read or manage then
            table.insert(result.channels,{id=id,name=Runtime.name(entry),channel=entry.channel,builtin=entry.builtin,
                canRead=read,canWrite=Permissions.channel(actor,id,"write"),canManage=manage,acl=if manage then Rules.copy(entry.acl) else nil,
                description=if read then "서버 권한이 적용된 통신 채널입니다." else "채널 관리 전용"})
        end
    end
    table.sort(result.channels,function(a,b) return a.id&lt;b.id end)
    -- Role names and grants are needed to edit channel ACLs; assignments remain manager-only.
    for id,role in data.roles do
        result.permissions.roles[id]={name=Runtime.name(role),permissions=Rules.copy(role.permissions),protected=table.find({"member","officer","operator","muted"},id)~=nil}
    end
    if result.canManageRoles then
        local online={}
        for _,p in Players:GetPlayers() do online[tostring(p.UserId)]={userId=p.UserId,name=p.Name,displayName=p.DisplayName,roles={}} end
        for key,roles in data.assignments do
            local person=online[key] or {userId=tonumber(key),name="User "..key,displayName="오프라인",roles={}}
            for id in roles do table.insert(person.roles,id) end
            online[key]=person
        end
        for _,person in online do table.insert(result.permissions.people,person) end
        table.sort(result.permissions.people,function(a,b) return a.userId&lt;b.userId end)
    end
    return result
end
local actions={create_channel=true,rename_channel=true,delete_channel=true,set_channel_access=true,create_role=true,rename_role=true,
    delete_role=true,set_permission=true,assign_role=true,remove_role=true}
Store.Changed:Connect(function() changed:FireAllClients() end)
local function incoming(actor: Player,action: any,payload: any)
    if actor.Parent~=Players or type(action)~="string" then return {ok=false,message="잘못된 요청입니다."} end
    local now=os.clock()
    if now-(last[actor] or -math.huge)&lt;0.2 then return {ok=false,message="잠시 후 다시 시도하세요."} end
    last[actor]=now
    if action=="snapshot" then return {ok=true,data=snapshot(actor)} end
    if action=="refresh" then Store.refresh();return {ok=true,data=snapshot(actor)} end
    if not actions[action] or type(payload)~="table" then return {ok=false,message="잘못된 입력입니다."} end
    if editing[actor] then return {ok=false,message="이전 변경을 저장 중입니다."} end
    editing[actor]=true
    local ok,result=pcall(function()
        -- Copy only whitelisted scalar values. Never traverse arbitrary remote tables.
        local op={action=action}
        for _,key in {"id","name","roleId","permission","mode"} do
            local value=payload[key]
            if value~=nil and (type(value)~="string" or #value&gt;96 or not utf8.len(value)) then return {ok=false,message="입력 형식 오류"} end
            op[key]=value
        end
        op.enabled=payload.enabled;op.userId=payload.userId
        if op.enabled~=nil and type(op.enabled)~="boolean" then return {ok=false,message="입력 형식 오류"} end
        if op.userId~=nil and type(op.userId)~="number" then return {ok=false,message="입력 형식 오류"} end
        op.permissions={}
        if action=="create_role" and payload.permissions~=nil then
            if type(payload.permissions)~="table" then return {ok=false,message="권한 형식 오류"} end
            for permission in Rules.PERMISSIONS do
                local value=payload.permissions[permission]
                if value~=nil and type(value)~="boolean" then return {ok=false,message="권한 형식 오류"} end
                if value then op.permissions[permission]=true end
            end
        end
        if action=="create_channel" then op.id="custom_"..HttpService:GenerateGUID(false):gsub("-","") end
        -- Reject unauthorized edits before expensive filtering; transaction re-checks latest stored roles.
        local preview,message=Rules.apply(Store.get(),Store.context(actor),op)
        if not preview then return {ok=false,message=message} end
        if op.name then
            if now-(metadataLast[actor] or -math.huge)&lt;60 then return {ok=false,message="이름 생성·변경은 1분에 한 번 가능합니다."} end
            metadataLast[actor]=now
            if not Runtime.filter(op.name,actor.UserId) then return {ok=false,message="이름 필터링 실패. 변경하지 않았습니다."} end
        end
        local success,notice=Store.commit(actor,op,payload.revision)
        return {ok=success,message=notice,data=snapshot(actor)}
    end)
    editing[actor]=nil
    if not ok then warn("[MessengerManage] request failed");return {ok=false,message="요청 처리 실패. 새로고침 후 저장 상태를 확인하세요."} end
    return result
end
remote.OnServerInvoke=incoming
Players.PlayerRemoving:Connect(function(p) last[p]=nil;editing[p]=nil;metadataLast[p]=nil end)
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="MessengerSync2"><Properties><string name="Name">MessengerPermissions</string><ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local Rules=require(script.Parent.MessengerState)
local Store=require(script.Parent.MessengerStore)
local Permissions={Changed=Store.Changed}
function Permissions.has(player: Player,permission: string): boolean
    return player.Parent==Players and Rules.has(Store.get(),Store.context(player),permission)
end
function Permissions.channel(player: Player,id: string,mode: string): boolean
    return player.Parent==Players and Rules.channel(Store.get(),Store.context(player),id,mode)
end
function Permissions.publish(player: Player)
    for attribute,permission in {MessengerCanSend="SEND_MESSAGES",MessengerCanCreate="CREATE_CHANNELS",MessengerCanDelete="DELETE_CHANNELS",
        MessengerCanManageRoles="MANAGE_ROLES",MessengerCanManageSettings="MANAGE_SETTINGS",MessengerCanPostNotices="POST_NOTICES",
        MessengerCanViewCommand="VIEW_COMMAND",MessengerCanWriteCommand="WRITE_COMMAND"} do
        player:SetAttribute(attribute,Permissions.has(player,permission))
    end
end
return Permissions
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync3"><Properties><string name="Name">MessengerRuntime</string><ProtectedString name="Source">--!strict
local Players=game:GetService("Players")
local TextChatService=game:GetService("TextChatService")
local TextService=game:GetService("TextService")
local Store=require(script.Parent.MessengerStore)
local Permissions=require(script.Parent.MessengerPermissions)
local Runtime={}
local started=false
local channels: {[string]: TextChannel}={}
local pending={}
local filtered={}
function Runtime.name(entry: any): string
    if entry.authorId==0 then return entry.name end
    local key=tostring(entry.authorId)..":"..entry.name
    return filtered[key] or "이름 확인 중"
end
function Runtime.filter(name: any,userId: number): string?
    if type(name)~="string" or #name&gt;96 or not utf8.len(name) then return nil end
    local ok,value=pcall(function()
        return TextService:FilterStringAsync(name,userId,Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync()
    end)
    if ok then
        filtered[tostring(userId)..":"..name]=value
        return value
    end
    return nil
end
local function unit(p: Player): string?
    local value=p:GetAttribute("Unit")
    if type(value)=="string" and value~="" then return value end
    return if p.Team and not p.Neutral then p.Team.Name else nil
end
local function delivery(id: string,message: TextChatMessage,recipient: TextSource): boolean
    if not Store.status().ready then return false end
    local sender=message.TextSource and Players:GetPlayerByUserId(message.TextSource.UserId)
    local receiver=Players:GetPlayerByUserId(recipient.UserId)
    if not sender or not receiver or not Permissions.channel(sender,id,"write") or not Permissions.channel(receiver,id,"read") then return false end
    return id~="unit" or (unit(sender)~=nil and unit(sender)==unit(receiver))
end
local function refreshPlayer(player: Player)
    if player.Parent~=Players then return end
    if pending[player]~=nil then pending[player]=true;return end
    pending[player]=false
    repeat
        pending[player]=false
        Permissions.publish(player)
        for id,channel in channels do
            local function allowed() return player.Parent==Players and channel.Parent~=nil and Store.status().ready and Permissions.channel(player,id,"read") end
            local source: TextSource?=nil
            for _,child in channel:GetChildren() do if child:IsA("TextSource") and child.UserId==player.UserId then source=child;break end end
            if allowed() and not source then
                -- AddUserAsync enforces Roblox communication eligibility; never create TextSources ourselves.
                local ok,result=pcall(function() return channel:AddUserAsync(player.UserId) end)
                if ok then source=result end
            end
            if source then
                if not allowed() then source:Destroy()
                else source.CanSend=Permissions.channel(player,id,"write") and (id~="unit" or unit(player)~=nil) end
            end
        end
    until not pending[player] or player.Parent~=Players
    pending[player]=nil
end
local function refreshOnce()
    local data=Store.get()
    -- Metadata filtering is separate from permissions, never inside ShouldDeliverCallback.
    local activeNames={}
    for _,group in {data.channels,data.roles} do
        for _,entry in group do
            if entry.authorId~=0 then
                local key=tostring(entry.authorId)..":"..entry.name;activeNames[key]=true
                if not filtered[key] then Runtime.filter(entry.name,entry.authorId) end
            end
        end
    end
    for key in filtered do if not activeNames[key] then filtered[key]=nil end end
    if Store.get()~=data then return false end
    for id,channel in channels do if not data.channels[id] then channel:Destroy();channels[id]=nil end end
    for id,entry in data.channels do
        if not channels[id] then
            local existing=TextChatService:FindFirstChild(entry.channel)
            if existing and not existing:IsA("TextChannel") then warn("[Messenger] TextChannel name collision");continue end
            local channel=existing or Instance.new("TextChannel")
            channel.Name=entry.channel
            channel.ShouldDeliverCallback=function(message,recipient) return delivery(id,message,recipient) end
            channel.Parent=TextChatService;channels[id]=channel
        end
    end
    for _,p in Players:GetPlayers() do task.spawn(refreshPlayer,p) end
    return true
end
local refreshing=false
local refreshAgain=false
function Runtime.refresh()
    if refreshing then refreshAgain=true;return end
    refreshing=true
    repeat
        refreshAgain=false
        local ok,complete=pcall(refreshOnce)
        if not ok then warn("[Messenger] refresh failed");break end
        if not complete then refreshAgain=true end
    until not refreshAgain
    refreshing=false
end
function Runtime.start()
    if started then return end;started=true
    local function added(p: Player)
        for _,attribute in {"RankOrder","Unit"} do p:GetAttributeChangedSignal(attribute):Connect(function() task.spawn(refreshPlayer,p) end) end
        for _,property in {"Team","Neutral"} do p:GetPropertyChangedSignal(property):Connect(function() task.spawn(refreshPlayer,p) end) end
        task.spawn(refreshPlayer,p)
    end
    Players.PlayerAdded:Connect(added)
    Players.PlayerRemoving:Connect(function(p) pending[p]=nil end)
    Store.Changed:Connect(function() task.spawn(Runtime.refresh) end)
    for _,p in Players:GetPlayers() do added(p) end
    task.spawn(Runtime.refresh)
    task.spawn(function() while true do task.wait(20);for _,p in Players:GetPlayers() do task.spawn(refreshPlayer,p) end end end)
end
return Runtime
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync4"><Properties><string name="Name">MessengerState</string><ProtectedString name="Source">--!strict
-- Pure, immutable configuration rules. No Roblox services or client trust.
local State = {}
State.OWNER = 1153125948
State.PERMISSIONS = {SEND_MESSAGES=true, CREATE_CHANNELS=true, DELETE_CHANNELS=true,
    MANAGE_ROLES=true, MANAGE_SETTINGS=true, POST_NOTICES=true, VIEW_COMMAND=true, WRITE_COMMAND=true}
local protected = {member=true, officer=true, operator=true, muted=true}
function State.copy(value: any): any
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in value do result[key] = State.copy(item) end
    return result
end
function State.default(): any
    local function role(name, grants) return {name=name, authorId=0, permissions=grants} end
    local function channel(id, name, transport, writer)
        return {id=id, name=name, authorId=0, channel=transport, builtin=true,
            acl={read={[if id=="command" then "officer" else "member"]=true}, write={[writer]=true}, manage={operator=true}}}
    end
    return {schema=1, revision=0, receipts={}, assignments={}, roles={
        member=role("일반 사용자",{SEND_MESSAGES=true}),
        officer=role("장교",{SEND_MESSAGES=true, POST_NOTICES=true, VIEW_COMMAND=true, WRITE_COMMAND=true}),
        operator=role("통신망 관리자",{SEND_MESSAGES=true, CREATE_CHANNELS=true, DELETE_CHANNELS=true, MANAGE_ROLES=true, MANAGE_SETTINGS=true}),
        muted=role("발언 제한",{}),
    }, channels={general=channel("general","전체 채팅","RP_General","member"),
        unit=channel("unit","부대 채팅","RP_Unit","member"),
        command=channel("command","지휘 채팅","RP_Command","officer"),
        notice=channel("notice","공지사항","RP_Notice","officer")}}
end
function State.rolesFor(data: any, actor: any): any
    local result = {member=true}
    if (actor.rankOrder or 0)&gt;=11 then result.officer=true end -- existing main behavior
    for id, enabled in data.assignments[tostring(actor.userId)] or {} do
        if enabled and data.roles[id] then result[id]=true end
    end
    return result
end
function State.has(data: any, actor: any, permission: string): boolean
    if not State.PERMISSIONS[permission] then return false end
    if actor.userId==State.OWNER then return true end
    local roles=State.rolesFor(data,actor)
    if roles.muted and (permission=="SEND_MESSAGES" or permission=="POST_NOTICES" or permission=="WRITE_COMMAND") then return false end
    for id in roles do if data.roles[id].permissions[permission] then return true end end
    return false
end
function State.channel(data: any, actor: any, id: string, mode: string): boolean
    local entry=data.channels[id]
    if not entry or not entry.acl[mode] then return false end
    if actor.userId==State.OWNER then return true end
    if mode=="manage" and State.has(data,actor,"MANAGE_SETTINGS") then return true end
    if mode=="write" then
        if not State.has(data,actor,"SEND_MESSAGES") or not State.channel(data,actor,id,"read") then return false end
        if id=="notice" and not State.has(data,actor,"POST_NOTICES") then return false end
        if id=="command" and not State.has(data,actor,"WRITE_COMMAND") then return false end
    end
    if id=="command" and mode=="read" and not State.has(data,actor,"VIEW_COMMAND") then return false end
    for role in State.rolesFor(data,actor) do if entry.acl[mode][role] then return true end end
    return false
end
local function count(items): number local n=0;for _ in items do n+=1 end;return n end
local function validName(name): boolean
    if type(name)~="string" or #name&gt;96 or name:find("[%c]") then return false end
    local length=utf8.len(name)
    return length~=nil and length&gt;=2 and length&lt;=24 and name:match("%S")~=nil
end
local function grantsValid(grants): boolean
    if type(grants)~="table" or count(grants)&gt;8 then return false end
    for key,value in grants do if not State.PERMISSIONS[key] or type(value)~="boolean" then return false end end
    return true
end
-- Stored configuration is bounded and validated before use; unknown schemas fail closed.
function State.valid(data: any): boolean
    if type(data)~="table" or data.schema~=1 or type(data.revision)~="number" or data.revision&lt;0 or data.revision%1~=0 then return false end
    for _,key in {"roles","channels","assignments","receipts"} do if type(data[key])~="table" then return false end end
    if count(data.roles)&gt;30 or count(data.channels)&gt;28 or count(data.assignments)&gt;1000 or #data.receipts&gt;64 then return false end
    for id in protected do if type(data.roles[id])~="table" then return false end end
    for id,role in data.roles do
        if type(id)~="string" or not id:match("^[a-z][a-z0-9_]*$") or #id&gt;48 or type(role)~="table" or not validName(role.name) or not grantsValid(role.permissions) or type(role.authorId)~="number" or role.authorId&lt;0 or role.authorId%1~=0 then return false end
    end
    for id,entry in data.channels do
        if type(id)~="string" or type(entry)~="table" or entry.id~=id or not validName(entry.name) or type(entry.authorId)~="number" or type(entry.channel)~="string" or type(entry.acl)~="table" then return false end
        if entry.authorId&lt;0 or entry.authorId%1~=0 then return false end
        local builtins={general="RP_General",unit="RP_Unit",command="RP_Command",notice="RP_Notice"}
        if builtins[id] then
            if entry.builtin~=true or entry.channel~=builtins[id] then return false end
        elseif entry.builtin~=false or not id:match("^custom_%w+$") or #id&gt;48 or entry.channel~="RP_"..id then return false end
        for _,mode in {"read","write","manage"} do
            if type(entry.acl[mode])~="table" or count(entry.acl[mode])&gt;30 then return false end
            for role,value in entry.acl[mode] do if not data.roles[role] or type(value)~="boolean" then return false end end
        end
    end
    for _,id in {"general","unit","command","notice"} do if not data.channels[id] or not data.channels[id].builtin then return false end end
    if count(data.receipts)&gt;64 or count(data.receipts)~=#data.receipts then return false end
    for _,receipt in data.receipts do
        if type(receipt)~="table" or type(receipt.id)~="string" or #receipt.id&gt;64 then return false end
    end
    for userId,roles in data.assignments do
        if type(userId)~="string" or not userId:match("^%d+$") or type(roles)~="table" or count(roles)&gt;30 then return false end
        for role,value in roles do if not data.roles[role] or value~=true then return false end end
    end
    return true
end
local function canGrant(data,actor,role): boolean
    for permission,enabled in role.permissions do if enabled and not State.has(data,actor,permission) then return false end end
    return true
end
function State.apply(data: any, actor: any, op: any): (any?, string)
    local updated=State.copy(data)
    local action=op.action
    local entry=updated.channels[op.id]
    local role=updated.roles[op.roleId]
    if action=="create_channel" then
        if not State.has(data,actor,"CREATE_CHANNELS") then return nil,"채널 개설 권한이 없습니다." end
        if not validName(op.name) or type(op.id)~="string" or not op.id:match("^custom_%w+$") or updated.channels[op.id] or count(updated.channels)&gt;=28 then return nil,"채널 이름 또는 개수 제한을 확인하세요." end
        for _,other in updated.channels do if other.name==op.name then return nil,"같은 이름의 채널이 있습니다." end end
        updated.channels[op.id]={id=op.id,name=op.name,authorId=actor.userId,channel="RP_"..op.id,builtin=false,acl={read={member=true},write={member=true},manage={operator=true}}}
    elseif action=="rename_channel" or action=="delete_channel" or action=="set_channel_access" then
        if not entry or not State.channel(data,actor,op.id,"manage") then return nil,"채널 관리 권한이 없습니다." end
        if action=="delete_channel" then
            if entry.builtin or not State.has(data,actor,"DELETE_CHANNELS") then return nil,"삭제할 수 없는 채널입니다." end
            updated.channels[op.id]=nil
        elseif action=="rename_channel" then
            if not validName(op.name) then return nil,"이름은 2~24자로 지정하세요." end
            for id,other in updated.channels do if id~=op.id and other.name==op.name then return nil,"같은 이름의 채널이 있습니다." end end
            entry.name=op.name;entry.authorId=actor.userId
        else
            if not updated.roles[op.roleId] or not entry.acl[op.mode] or type(op.enabled)~="boolean" then return nil,"잘못된 채널 권한입니다." end
            entry.acl[op.mode][op.roleId]=op.enabled or nil
        end
    elseif action=="create_role" or action=="rename_role" or action=="delete_role" or action=="set_permission" or action=="assign_role" or action=="remove_role" then
        if not State.has(data,actor,"MANAGE_ROLES") then return nil,"역할 관리 권한이 없습니다." end
        if action=="create_role" then
            if type(op.roleId)~="string" or not op.roleId:match("^[a-z][a-z0-9_]*$") or #op.roleId&lt;3 or #op.roleId&gt;24 or role or count(updated.roles)&gt;=30 or not validName(op.name) or not grantsValid(op.permissions) then return nil,"역할 ID·이름·권한을 확인하세요." end
            local created={name=op.name,authorId=actor.userId,permissions=State.copy(op.permissions)}
            if not canGrant(data,actor,created) then return nil,"보유하지 않은 권한은 부여할 수 없습니다." end
            updated.roles[op.roleId]=created
        else
            if not role or not canGrant(data,actor,role) then return nil,"이 역할을 관리할 권한이 부족합니다." end
            if action=="assign_role" or action=="remove_role" then
                if op.roleId=="member" or op.roleId=="officer" or type(op.userId)~="number" or op.userId&lt;1 or op.userId%1~=0 or op.userId&gt;2^53 then return nil,"유효한 사용자 ID와 수동 역할을 선택하세요." end
                local key=tostring(op.userId)
                if not updated.assignments[key] and count(updated.assignments)&gt;=1000 then return nil,"사용자 배정 한도입니다." end
                updated.assignments[key]=updated.assignments[key] or {}
                updated.assignments[key][op.roleId]=if action=="assign_role" then true else nil
                if next(updated.assignments[key])==nil then updated.assignments[key]=nil end
            else
                if protected[op.roleId] then return nil,"기본 역할은 보호됩니다." end
                if action=="rename_role" then
                    if not validName(op.name) then return nil,"역할 이름은 2~24자입니다." end
                    role.name=op.name;role.authorId=actor.userId
                elseif action=="set_permission" then
                    if not State.PERMISSIONS[op.permission] or type(op.enabled)~="boolean" or (op.enabled and not State.has(data,actor,op.permission)) then return nil,"권한을 부여할 수 없습니다." end
                    role.permissions[op.permission]=op.enabled or nil
                else
                    updated.roles[op.roleId]=nil
                    for key,assigned in updated.assignments do assigned[op.roleId]=nil;if next(assigned)==nil then updated.assignments[key]=nil end end
                    for _,channel in updated.channels do for _,acl in channel.acl do acl[op.roleId]=nil end end
                end
            end
        end
    else return nil,"알 수 없는 요청입니다." end
    updated.revision+=1
    return updated,"저장 완료"
end
return State
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync5"><Properties><string name="Name">MessengerStore</string><ProtectedString name="Source">--!strict
local DataStoreService=game:GetService("DataStoreService")
local MessagingService=game:GetService("MessagingService")
local HttpService=game:GetService("HttpService")
local RunService=game:GetService("RunService")
local Rules=require(script.Parent.MessengerState)
local Core=require(script.Parent.MessengerStoreCore)
local Store={}
local changed=Instance.new("BindableEvent")
Store.Changed=changed.Event
local name=if RunService:IsStudio() then "MilitaryMessenger_Config_Dev_v1" else "MilitaryMessenger_Config_v1"
local key="configuration"
local topic=name.."_revision"
local dataStore
local ok=pcall(function() dataStore=DataStoreService:GetDataStore(name) end)
local core=Core.new(Rules,{
    get=function() assert(ok and dataStore,"DataStore unavailable");return dataStore:GetAsync(key) end,
    update=function(transform)
        return dataStore:UpdateAsync(key,function(current)
            local updated=transform(current)
            if updated and #HttpService:JSONEncode(updated)&gt;1000000 then error("Configuration exceeds 1MB") end
            return updated
        end)
    end,
    wait=task.wait,
    id=function() return HttpService:GenerateGUID(false) end,
})
function Store.get() return core.data end
function Store.status() return {ready=core.ready,revision=core.data.revision,error=core.error,store=name} end
function Store.context(player: Player) return {userId=player.UserId,rankOrder=tonumber(player:GetAttribute("RankOrder")) or 0} end
function Store.refresh()
    local before=core.data.revision
    local wasReady=core.ready
    core:load()
    if core.data.revision~=before or core.ready~=wasReady then changed:Fire() end
end
function Store.commit(player: Player,op: any,revision: any): (boolean,string)
    local before=core.data.revision
    local success,message=core:commit(Store.context(player),op,revision)
    if core.data.revision~=before then changed:Fire() end
    if success then
        task.spawn(function() pcall(function() MessagingService:PublishAsync(topic,{revision=core.data.revision}) end) end)
    end
    return success,message
end
-- Notifications are hints; periodic reads recover dropped/out-of-order messages.
task.spawn(function()
    Store.refresh()
    while true do
        local subscribed=pcall(function()
            MessagingService:SubscribeAsync(topic,function(message)
                local data=message.Data
                if type(data)=="table" and type(data.revision)=="number" and data.revision&gt;core.data.revision then task.spawn(Store.refresh) end
            end)
        end)
        if subscribed then break end
        task.wait(30)
    end
end)
task.spawn(function() while true do task.wait(30+math.random()*10);Store.refresh() end end)
-- No dirty write-behind cache: acknowledged changes have already committed in UpdateAsync.
return Store
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="MessengerSync6"><Properties><string name="Name">MessengerStoreCore</string><ProtectedString name="Source">--!strict
-- Adapter-driven transactional persistence, exercised with an in-memory fault-injecting store.
local Core={}
function Core.new(rules: any, adapter: any): any
    local self={data=rules.default(),ready=false,busy=false,error="설정을 불러오는 중입니다."}
    local function accept(data)
        if not rules.valid(data) then return false end
        if data.revision&gt;=self.data.revision then self.data=rules.copy(data) end
        self.ready=true;self.error=""
        return true
    end
    function self:load(): boolean
        if self.busy then return false end
        self.busy=true
        local ok,value=pcall(adapter.get)
        self.busy=false
        if ok and accept(if value==nil then rules.default() else value) then return true end
        self.ready=false;self.error="저장소를 불러오지 못했습니다. 관리 변경은 잠겨 있습니다."
        return false
    end
    function self:commit(actor: any, op: any, expected: any): (boolean,string)
        if not self.ready or self.busy then return false,"설정 로딩 또는 저장 중입니다. 새로고침 후 시도하세요." end
        if type(expected)~="number" or expected%1~=0 or expected~=self.data.revision then return false,"다른 변경이 반영되었습니다. 새로고침 후 다시 시도하세요." end
        self.busy=true
        local operationId=adapter.id()
        local reason="저장 결과를 확인하지 못했습니다. 새로고침하여 상태를 확인하세요."
        for attempt=1,3 do
            local resultOk=false
            local ok,saved=pcall(function()
                return adapter.update(function(current)
                    local data=if current==nil then rules.default() else current
                    if not rules.valid(data) then reason="지원하지 않거나 손상된 저장 데이터입니다.";return nil end
                    for _,receipt in data.receipts do
                        if receipt.id==operationId then resultOk=true;return data end
                    end
                    if data.revision~=expected then reason="다른 서버에서 수정했습니다. 새로고침 후 다시 시도하세요.";return nil end
                    local changed,message=rules.apply(data,actor,op)
                    reason=message
                    if not changed then return nil end
                    table.insert(changed.receipts,{id=operationId})
                    if #changed.receipts&gt;64 then table.remove(changed.receipts,1) end
                    if not rules.valid(changed) then reason="설정 데이터 검증 실패";return nil end
                    resultOk=true
                    return changed
                end)
            end)
            if ok then
                if resultOk and saved and accept(saved) then self.busy=false;return true,"영구 저장 완료" end
                self.busy=false
                self:load() -- conflict reload; never overwrite a newer revision with a cached snapshot
                return false,reason
            end
            if attempt&lt;3 then adapter.wait(0.4*2^(attempt-1)) end
        end
        self.busy=false
        self:load() -- write outcome can be unknown; reconcile without claiming success
        return false,"저장 응답을 확인하지 못했습니다. 새로고침된 결과를 확인하세요."
    end
    return self
end
return Core
