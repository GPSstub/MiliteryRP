		<Item class="ModuleScript" referent="RBXc964fa98844d4e58a27bb6060e918a13">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RankCatalog"))
type Rank = Catalog.Rank
local Insignia = {}
local ATLAS = "rbxassetid://97383962049559"
local COLUMNS, ROWS = 4, 5
function Insignia.render(tag: Instance, rank: Rank)
    local previous = tag:FindFirstChild("Insignia")
    if previous then previous:Destroy() end
    local plate = Instance.new("Frame")
    plate.Name = "Insignia"
    plate.AnchorPoint = Vector2.new(0.5, 0)
    plate.Position = UDim2.new(0.5, 0, 0, 24)
    plate.Size = UDim2.fromOffset(38, 38)
    plate.BackgroundTransparency = 1
    plate.BorderSizePixel = 0
    plate.ClipsDescendants = true
    plate:SetAttribute("RankId", rank.id)
    plate:SetAttribute("Symbol", rank.symbol)
    plate:SetAttribute("Marks", rank.marks)
    plate.Parent = tag
    if rank.symbol == "training" then return end
    local index = rank.order - 1
    local column, row = index % COLUMNS, math.floor(index / COLUMNS)
    -- Normalized clipping remains correct if Roblox resizes the uploaded texture.
    local image = Instance.new("ImageLabel")
    image.Name = "Atlas"
    image.BackgroundTransparency = 1
    image.BorderSizePixel = 0
    image.Image = ATLAS
    image.ScaleType = Enum.ScaleType.Stretch
    image.Size = UDim2.fromScale(COLUMNS, ROWS)
    image.Position = UDim2.fromScale(-column, -row)
    image.Parent = plate
end
return Insignia
]]></ProtectedString>
				<string name="ScriptGuid">{6b7b055f-7876-4d3a-9563-21e6b1ea6d00}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">RankInsignia</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">08c4e9987925be9f0ae78ca800000f5a</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX8d14c6b162fe493695e5f9f861e5f7c4">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[--!strict
-- Supports ;계급 나 대위, ;계급 일부 대위, and DisplayNames with spaces.
export type Command={kind: string,target: string?,rank: string?}
local Parser={}

function Parser.parse(message: any): Command?
    if type(message)~="string" or #message>256 or not utf8.len(message) then return nil end
    local verb,arguments=message:match("^%s*(%S+)%s*(.-)%s*$")
    if not verb then return nil end
    local alias=string.lower(verb)
    if alias==";계급목록" or alias==";ranks" then
        return if arguments=="" then {kind="list"} else nil
    end
    if alias~=";계급" and alias~=";rank" then return nil end
    if arguments=="" or arguments:find("[%c]") then return nil end
    -- The last word is a rank name or ID. Everything before it can be an
    -- arbitrary Unicode DisplayName, optionally containing spaces.
    local target,rank=arguments:match("^(.-)%s+(%S+)$")
    if not rank then
        rank=arguments
        target=nil
    else
        target=target:match("^%s*(.-)%s*$") or ""
        if target=="" or #target>100 then return nil end
        if target:sub(1,1)=='"' and target:sub(-1)=='"' then
            target=target:sub(2,-2)
        end
        if target=="" then return nil end
    end
    if #rank>60 or rank:find("[;]") then return nil end
    return {kind="set",target=target,rank=rank}
end
return table.freeze(Parser)
]]></ProtectedString>
				<string name="ScriptGuid">{9a72c432-67a1-4a78-85fb-272afd6b0d86}</string>
