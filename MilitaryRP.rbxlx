		<Item class="LocalScript" referent="MessengerSync4"><Properties><string name="Name">TrainingRifle</string><ProtectedString name="Source">--!strict
-- Equip-aware HUD and input for the server-authoritative training rifle.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local ContextActionService=game:GetService("ContextActionService")
local TweenService=game:GetService("TweenService")
local UserInputService=game:GetService("UserInputService")
local player=Players.LocalPlayer
local mouse=player:GetMouse()
local Rules=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("TrainingRifleRules"))
local Spring=require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RifleRecoilSpring"))
local Viewmodel=require(script.Parent:WaitForChild("RifleViewmodel"))
local RunService=game:GetService("RunService")
local remote=ReplicatedStorage:WaitForChild("TrainingRifleAction") :: RemoteEvent

local gui=Instance.new("ScreenGui")
gui.Name="TrainingRifleHUD"
gui.ResetOnSpawn=false
gui.DisplayOrder=35
gui.ScreenInsets=Enum.ScreenInsets.CoreUISafeInsets
gui.Parent=player:WaitForChild("PlayerGui")
local panel=Instance.new("Frame")
panel.Name="AmmoPanel"
panel.AnchorPoint=Vector2.new(1,1)
panel.Position=UDim2.new(1,-18,1,-18)
panel.Size=UDim2.fromOffset(208,91)
panel.BackgroundColor3=Color3.fromRGB(20,23,29)
panel.BackgroundTransparency=0.06
panel.BorderSizePixel=0
panel.Visible=false
panel.Parent=gui
local corner=Instance.new("UICorner")
corner.CornerRadius=UDim.new(0,12)
corner.Parent=panel
local stroke=Instance.new("UIStroke")
stroke.Color=Color3.fromRGB(75,83,84)
stroke.Transparency=0.25
stroke.Parent=panel
local title=Instance.new("TextLabel")
title.Name="WeaponName"
title.Text=Rules.DISPLAY_NAME
title.Size=UDim2.new(1,-20,0,22)
title.Position=UDim2.fromOffset(10,4)
title.BackgroundTransparency=1
title.TextColor3=Color3.fromRGB(204,208,201)
title.Font=Enum.Font.GothamMedium
title.TextSize=12
title.TextXAlignment=Enum.TextXAlignment.Left
title.Parent=panel
local ammo=Instance.new("TextLabel")
ammo.Name="Ammo"
ammo.Text="30 / 90"
ammo.Size=UDim2.new(1,-20,0,43)
ammo.Position=UDim2.fromOffset(10,24)
ammo.BackgroundTransparency=1
ammo.TextColor3=Color3.fromRGB(244,245,237)
ammo.Font=Enum.Font.GothamBold
ammo.TextSize=29
ammo.TextXAlignment=Enum.TextXAlignment.Right
ammo.Parent=panel
local hint=Instance.new("TextLabel")
hint.Name="Hint"
hint.Text="R  ·  재장전"
hint.Size=UDim2.new(1,-20,0,19)
hint.Position=UDim2.fromOffset(10,69)
hint.BackgroundTransparency=1
hint.TextColor3=Color3.fromRGB(170,185,171)
hint.Font=Enum.Font.Gotham
hint.TextSize=12
hint.TextXAlignment=Enum.TextXAlignment.Right
hint.Parent=panel
local function layoutHUD()
    local size=gui.AbsoluteSize
    local compact=size.X&lt;760 or size.Y&lt;520
    local touch=UserInputService.TouchEnabled and compact
    panel.AnchorPoint=if touch then Vector2.new(0.5,0) else Vector2.new(1,1)
    panel.Position=if touch then UDim2.new(0.5,0,0,4) else UDim2.new(1,-12,1,-12)
    panel.Size=UDim2.fromOffset(if compact then 158 else 208,if compact then 78 else 91)
    ammo.TextSize=if compact then 24 else 29
    ammo.Position=UDim2.fromOffset(10,if compact then 20 else 24)
    ammo.Size=UDim2.new(1,-20,0,if compact then 34 else 43)
    hint.Position=UDim2.fromOffset(10,if compact then 56 else 69)
    title.TextSize=if compact then 11 else 12
end
gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(layoutHUD)
UserInputService:GetPropertyChangedSignal("TouchEnabled"):Connect(layoutHUD)
layoutHUD()

local crosshair=Instance.new("TextLabel")
crosshair.Name="RifleReticle"
crosshair.AnchorPoint=Vector2.new(0.5,0.5)
crosshair.Position=UDim2.fromScale(0.5,0.5)
crosshair.Size=UDim2.fromOffset(30,30)
crosshair.BackgroundTransparency=1
crosshair.Text="+"
crosshair.TextColor3=Color3.fromRGB(240,242,237)
crosshair.TextStrokeTransparency=0.6
crosshair.TextSize=28
crosshair.Font=Enum.Font.Gotham
crosshair.Visible=false
crosshair.Parent=gui

local selected: Tool?=nil
-- Client-only body/weapon motion complements the server-replicated moving
-- magazine and bolt. No uploaded AnimationId assets are required.
local baseGrip: CFrame?=nil
local movementVersion=0
local recoilPosition=0
local recoilVelocity=0
local recoilActive=false
local previousCameraKick=0
local currentGripTween: Tween?=nil
local leftShoulder: Motor6D?=nil
local leftShoulderBase: CFrame?=nil
local armTween: Tween?=nil

local function animateGrip(tool: Tool,target: CFrame,duration: number,style: Enum.EasingStyle?)
    if currentGripTween then currentGripTween:Cancel() end
    if tool.Parent==nil then return end
    local tween=TweenService:Create(tool,TweenInfo.new(duration,style or Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out),{Grip=target})
    currentGripTween=tween
    tween:Play()
end
local function shoulderTarget(target: CFrame,duration: number)
    if armTween then armTween:Cancel() end
    if not leftShoulder or not leftShoulder.Parent then return end
    armTween=TweenService:Create(leftShoulder,TweenInfo.new(duration,Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out),{C0=target})
    armTween:Play()
end
local function findShoulder()
    leftShoulder=nil
    leftShoulderBase=nil
    local character=player.Character
    if not character then return end
    local humanoid=character:FindFirstChildOfClass("Humanoid")
    -- R15 off-hand is driven by a server IKControl linked to the weapon.
    -- Rotating LeftShoulder.C0 here would fight the whole-arm IK solver.
    if humanoid and humanoid.RigType==Enum.HumanoidRigType.R15 then return end
    local torso=character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
    if not torso then return end
    local shoulder=torso:FindFirstChild("LeftShoulder") or torso:FindFirstChild("Left Shoulder")
    if shoulder and shoulder:IsA("Motor6D") then
        leftShoulder=shoulder
        leftShoulderBase=shoulder.C0
    end
end
local function recoil(tool: Tool)
    if selected~=tool or not baseGrip then return end
    if tool:GetAttribute("Reloading")==true then return end
    -- Add velocity rather than teleporting to a rotation. Critical damping
    -- gives visible upward travel and a smooth, gradual downward recovery.
    if currentGripTween then currentGripTween:Cancel();currentGripTween=nil end
    movementVersion+=1
    recoilVelocity=math.min(recoilVelocity+Spring.KICK,Spring.KICK*1.5)
    recoilActive=true
end

RunService:BindToRenderStep("TrainingRifleSmoothRecoil",
    Enum.RenderPriority.Camera.Value+1,function(dt)
        if not selected then return end
        recoilPosition,recoilVelocity=Spring.step(recoilPosition,recoilVelocity,dt)
        local camera=workspace.CurrentCamera
        local nextCameraKick=recoilPosition*1.65
        if camera then
            local delta=nextCameraKick-previousCameraKick
            camera.CFrame=camera.CFrame*CFrame.Angles(math.rad(delta),0,0)
        end
        previousCameraKick=nextCameraKick
        if recoilActive and baseGrip and selected:GetAttribute("Reloading")~=true then
            local rest=baseGrip
            selected.Grip=rest*CFrame.new(0,-recoilPosition*0.04,recoilPosition*0.12)
                *CFrame.Angles(math.rad(recoilPosition*6),0,0)
            if recoilPosition==0 and recoilVelocity==0 then
                selected.Grip=rest
                recoilActive=false
            end
        end
        -- RightGrip is disabled while the torso mount holds the rifle.
        -- Convert the same equip/reload/recoil Grip pose into mount space so
        -- the intentional animations survive without following arm swings.
        local handle=selected:FindFirstChild("Handle")
        local mount=if handle then handle:FindFirstChild("RifleHoldJoint") else nil
        if mount and mount:IsA("Motor6D") and baseGrip then
            local rest=mount:GetAttribute("RestC0")
            if typeof(rest)=="CFrame" then
                mount.C0=rest*baseGrip*selected.Grip:Inverse()
            end
        end
        Viewmodel.update(selected,camera,if baseGrip then baseGrip*selected.Grip:Inverse() else CFrame.identity)
    end)

local function reloadPose(tool: Tool)
    if selected~=tool or not baseGrip then return end
    movementVersion+=1
    recoilActive=false
    local version=movementVersion
    local rest=baseGrip
    animateGrip(tool,rest*CFrame.new(0,-0.12,0.16)
        *CFrame.Angles(math.rad(21),math.rad(-12),math.rad(-9)),0.24)
    if leftShoulder and leftShoulderBase then
        shoulderTarget(leftShoulderBase*CFrame.Angles(math.rad(-46),0,math.rad(32)),0.25)
    end
    task.delay(0.38,function()
        if movementVersion~=version or selected~=tool then return end
        animateGrip(tool,rest*CFrame.new(0,-0.18,0.22)
            *CFrame.Angles(math.rad(31),math.rad(-18),math.rad(-12)),0.33)
    end)
    task.delay(1.17,function()
        if movementVersion~=version or selected~=tool then return end
        animateGrip(tool,rest,0.48,Enum.EasingStyle.Back)
        if leftShoulder and leftShoulderBase then
            shoulderTarget(leftShoulderBase*CFrame.Angles(math.rad(-22),0,math.rad(14)),0.42)
        end
    end)
end
-- A rejected shot (wall obstruction, cooldown, empty magazine) must not kick.
remote.OnClientEvent:Connect(function(action: unknown,tool: unknown,hitPoint: unknown)
    if action=="shot" and typeof(tool)=="Instance" and tool:IsA("Tool") and selected==tool then
        recoil(tool)
        if typeof(hitPoint)=="Vector3" then Viewmodel.shot(tool,hitPoint) end
    end
end)
local observed: {[Tool]: boolean}=setmetatable({}, {__mode="k"})
local function updateAmmo()
    local tool=selected
    if not tool then return end
    local mag=tool:GetAttribute("Ammo")
    local reserve=tool:GetAttribute("Reserve")
    local isReloading=tool:GetAttribute("Reloading")==true
    ammo.Text=tostring(if type(mag)=="number" then mag else "?")
        .." / "..(if tool:GetAttribute("UnlimitedReserve")==true then "∞" else tostring(if type(reserve)=="number" then reserve else "?"))
    hint.Text=if isReloading then "재장전 중..."
        elseif mag==0 and reserve==0 then "예비 탄약 없음"
        else (if UserInputService.TouchEnabled then "재장전 버튼" else "R  ·  재장전")
end
local function reloadAction(_name: string,inputState: Enum.UserInputState,_input: InputObject): Enum.ContextActionResult
    if inputState==Enum.UserInputState.Begin and selected then
        remote:FireServer("reload")
    end
    return Enum.ContextActionResult.Sink
end
local function unequip(tool: Tool)
    if selected~=tool then return end
    movementVersion+=1
    recoilActive=false
    recoilPosition=0
    recoilVelocity=0
    previousCameraKick=0
    if currentGripTween then currentGripTween:Cancel();currentGripTween=nil end
    if baseGrip then tool.Grip=baseGrip end
    if armTween then armTween:Cancel();armTween=nil end
    if leftShoulder and leftShoulderBase and leftShoulder.Parent then
        leftShoulder.C0=leftShoulderBase
    end
    leftShoulder=nil
    leftShoulderBase=nil
    baseGrip=nil
    selected=nil
    Viewmodel.clear()
    panel.Visible=false
    crosshair.Visible=false
    ContextActionService:UnbindAction("TrainingRifleReload")
end
local function equip(tool: Tool)
    if selected==tool then return end
    if selected then unequip(selected) end
    selected=tool
    baseGrip=tool.Grip
    movementVersion+=1
    local version=movementVersion
    recoilActive=false
    recoilPosition=0
    recoilVelocity=0
    previousCameraKick=0
    findShoulder()
    panel.Visible=true
    -- PC now aims by mouse cursor, not the center reticle. Avoid drawing
    -- a misleading fixed '+' at screen center. Touch retains center aiming.
    crosshair.Visible=not UserInputService.MouseEnabled
    updateAmmo()
    local rest=baseGrip
    tool.Grip=rest*CFrame.new(0,-0.15,0.14)*CFrame.Angles(math.rad(20),0,0)
    task.defer(function()
        if selected==tool and movementVersion==version then animateGrip(tool,rest,0.23) end
    end)
    if leftShoulder and leftShoulderBase then
        shoulderTarget(leftShoulderBase*CFrame.Angles(math.rad(-22),0,math.rad(14)),0.22)
    end
    ContextActionService:BindAction("TrainingRifleReload",reloadAction,true,Enum.KeyCode.R)
    ContextActionService:SetTitle("TrainingRifleReload","재장전")
    ContextActionService:SetPosition("TrainingRifleReload",UDim2.new(1,-132,1,-200))
    local reloadButton=ContextActionService:GetButton("TrainingRifleReload")
    if reloadButton then reloadButton.Size=UDim2.fromOffset(52,52) end
    if tool:GetAttribute("Reloading")==true then reloadPose(tool) end
end
local function observe(child: Instance)
    if not child:IsA("Tool") then return end
    local tool=child :: Tool
    if observed[tool] then return end
    if tool:GetAttribute("WeaponId")~=Rules.WEAPON_ID then
        -- Attributes can replicate immediately after a new Backpack child.
        local connection: RBXScriptConnection?=nil
        connection=tool:GetAttributeChangedSignal("WeaponId"):Connect(function()
            if tool:GetAttribute("WeaponId")==Rules.WEAPON_ID then
                if connection then connection:Disconnect() end
                observe(tool)
            end
        end)
        return
    end
    observed[tool]=true
    tool.Equipped:Connect(function() equip(tool) end)
    tool.Unequipped:Connect(function() unequip(tool) end)
    tool.Destroying:Connect(function() unequip(tool) end)
    tool.Activated:Connect(function()
        if selected~=tool then return end
        local camera=workspace.CurrentCamera
        if not camera then return end
        -- PC mouse.UnitRay points at the actual pointer position, including
        -- when the camera is in third person. Shift-lock naturally aims
        -- through the locked cursor. Mobile still uses a center-screen ray.
        local ray: Ray
        if UserInputService.MouseEnabled then
            ray=mouse.UnitRay
        else
            local size=camera.ViewportSize
            ray=camera:ViewportPointToRay(size.X*0.5,size.Y*0.5)
        end
        local params=RaycastParams.new()
        params.FilterType=Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances=if player.Character then {player.Character} else {}
        params.IgnoreWater=true
        local hit=workspace:Raycast(ray.Origin,ray.Direction*Rules.RANGE,params)
        local aimPoint=if hit then hit.Position else ray.Origin+ray.Direction*Rules.RANGE
        remote:FireServer("fire",aimPoint)
    end)
    for _,attribute in {"Ammo","Reserve","Reloading","UnlimitedReserve"} do
        tool:GetAttributeChangedSignal(attribute):Connect(function()
            if selected==tool then
                updateAmmo()
                if attribute=="Reloading" and tool:GetAttribute("Reloading")==true then
                    reloadPose(tool)
                end
            end
        end)
    end
    if tool.Parent==player.Character then equip(tool) end
end
local backpack=player:WaitForChild("Backpack")
backpack.ChildAdded:Connect(observe)
for _,item in backpack:GetChildren() do observe(item) end
local function watchCharacter(character: Model)
    character.ChildAdded:Connect(observe)
    for _,item in character:GetChildren() do observe(item) end
    if selected and selected.Parent~=character then unequip(selected) end
end
player.CharacterAdded:Connect(watchCharacter)
if player.Character then watchCharacter(player.Character) end
</ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="ModuleScript" referent="MessengerSync5"><Properties><string name="Name">RifleViewmodel</string><ProtectedString name="Source">--!strict
-- Local camera-space presentation only. Hits, ammo and wall checks stay server-side.
local Players=game:GetService("Players")
local Debris=game:GetService("Debris")
local player=Players.LocalPlayer
local Viewmodel={}
local CAMERA_GRIP=CFrame.new(0.60,-0.70,-0.75)
local owner: Tool?=nil
local model: Model?=nil
local sourceHandle: BasePart?=nil
local copies: {[BasePart]: BasePart}={}
local hidden: {[BasePart]: number}={}
local hiddenParticles: {[ParticleEmitter]: number}={}
local lastFrame=CFrame.identity

function Viewmodel.clear()
    for part,value in hidden do
        if part.Parent then part.LocalTransparencyModifier=value end
    end
    for emitter,value in hiddenParticles do
        if emitter.Parent then emitter.LocalTransparencyModifier=value end
    end
    table.clear(copies)
    table.clear(hidden)
    table.clear(hiddenParticles)
    if model then model:Destroy() end
    owner=nil
    model=nil
    sourceHandle=nil
end

local function addPart(part: BasePart,parent: Model)
    local copy=part:Clone()
    for _,child in copy:GetDescendants() do
        -- Modern R15 rigs also use AnimationConstraint/RigidConstraint, whose
        -- attachments can still refer to the REAL character after Part:Clone.
        -- Strip every physics/animation controller BEFORE anchoring/parenting.
        if child:IsA("JointInstance") or child:IsA("WeldConstraint")
            or child:IsA("Constraint") or child:IsA("BodyMover")
            or child:IsA("IKControl") or child:IsA("Humanoid")
            or child:IsA("AnimationController") or child:IsA("Animator")
            or child:IsA("Sound") or child:IsA("LuaSourceContainer") then
            child:Destroy()
        end
    end
    copy.Anchored=true
    copy.CanCollide=false
    copy.CanTouch=false
    copy.CanQuery=false
    copy.CastShadow=false
    copy.LocalTransparencyModifier=0
    copy.Parent=parent
    copies[part]=copy
    hidden[part]=part.LocalTransparencyModifier
    for _,child in part:GetDescendants() do
        if child:IsA("ParticleEmitter") then
            hiddenParticles[child]=child.LocalTransparencyModifier
        end
    end
end

local function build(tool: Tool,camera: Camera): boolean
    local handle=tool:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return false end
    local view=Instance.new("Model")
    view.Name="TrainingRifleViewmodel"
    for _,child in tool:GetChildren() do
        if child:IsA("BasePart") then addPart(child,view) end
    end
    local character=player.Character
    if character then
        for _,name in {"RightUpperArm","RightLowerArm","RightHand",
            "LeftUpperArm","LeftLowerArm","LeftHand","Right Arm","Left Arm"} do
            local arm=character:FindFirstChild(name)
            if arm and arm:IsA("BasePart") then addPart(arm,view) end
        end
    end
    sourceHandle=handle
    owner=tool
    model=view
    view.Parent=camera
    return true
end

function Viewmodel.update(tool: Tool?,camera: Camera?,pose: CFrame)
    local firstPerson=camera~=nil and (player.CameraMode==Enum.CameraMode.LockFirstPerson
        or (camera.CFrame.Position-camera.Focus.Position).Magnitude&lt;1)
    if not firstPerson or not tool or not camera then
        if model then Viewmodel.clear() end
        return
    end
    if owner~=tool then
        Viewmodel.clear()
        if not build(tool,camera) then return end
    end
    local view=model
    local handle=sourceHandle
    if not view or not handle or not handle.Parent then Viewmodel.clear();return end
    view.Parent=camera
    lastFrame=camera.CFrame*CAMERA_GRIP*pose
    for source,copy in copies do
        if source.Parent and copy.Parent then
            source.LocalTransparencyModifier=1
            copy.CFrame=lastFrame*handle.CFrame:ToObjectSpace(source.CFrame)
        end
    end
    for emitter in hiddenParticles do
        if emitter.Parent then emitter.LocalTransparencyModifier=1 end
    end
end

function Viewmodel.shot(tool: Tool,hitPoint: Vector3)
    if owner~=tool or not model then return end
    local muzzle=model:FindFirstChild("Muzzle",true)
    if not muzzle or not muzzle:IsA("Attachment") then return end
    local spark=muzzle:FindFirstChild("MuzzleFlash")
    if spark and spark:IsA("ParticleEmitter") then spark:Emit(7) end
    local light=muzzle:FindFirstChild("FlashLight")
    if light and light:IsA("PointLight") then
        light.Enabled=true
        task.delay(0.07,function() if light.Parent then light.Enabled=false end end)
    end
    local origin=muzzle.WorldPosition
    local distance=(hitPoint-origin).Magnitude
    if distance&lt;0.1 then return end
    local tracer=Instance.new("Part")
    tracer.Name="TrainingRifleViewTracer"
    tracer.Anchored=true
    tracer.CanCollide=false
    tracer.CanTouch=false
    tracer.CanQuery=false
    tracer.Material=Enum.Material.Neon
    tracer.Color=Color3.fromRGB(251,202,130)
    tracer.Transparency=0.35
    tracer.Size=Vector3.new(0.035,0.035,distance)
    tracer.CFrame=CFrame.lookAt(origin,hitPoint)*CFrame.new(0,0,-distance/2)
    tracer.Parent=workspace
    Debris:AddItem(tracer,0.075)
end

-- Hide only our own world-space tracer while showing the camera-space one.
-- Other players keep seeing the authoritative muzzle and tracer as usual.
workspace.ChildAdded:Connect(function(child: Instance)
    if child.Name~="TrainingRifleTracer" or not child:IsA("BasePart") then return end
    local function hideOwnTracer()
        if model and child:GetAttribute("ShooterUserId")==player.UserId then
            child.LocalTransparencyModifier=1
        end
    end
    hideOwnTracer()
    local connection=child:GetAttributeChangedSignal("ShooterUserId"):Connect(hideOwnTracer)
    child.Destroying:Once(function() connection:Disconnect() end)
end)
return Viewmodel
</ProtectedString></Properties></Item><Item class="LocalScript" referent="MessengerSync9"><Properties><string name="Name">MobileLayout</string><ProtectedString name="Source">--!strict
-- Keep phone launchers and the weapon HUD clear of open full-screen panels.
local Players=game:GetService("Players")
local playerGui=Players.LocalPlayer:WaitForChild("PlayerGui")
local watched: {[Instance]: boolean}={}
local windows={ContentPanel=true,MessengerWindow=true,ExamWindow=true,DimOverlay=true}
local launchers={MenuButton=true,CommunicationButton=true,ExamButton=true}
local function refresh()
    local camera=workspace.CurrentCamera
    if not camera then return end
    local compact=camera.ViewportSize.X&lt;900 or camera.ViewportSize.Y&lt;580
    local modal=false
    if compact then
        for object in watched do
            if object.Parent and object:IsA("GuiObject") and windows[object.Name] and object.Visible then
                modal=true;break
            end
        end
    end
    for object in watched do
        if object.Parent and object:IsA("GuiObject") and launchers[object.Name] then
            local ownWindow=if object.Name=="CommunicationButton" and object.Parent then object.Parent:FindFirstChild("MessengerWindow") else nil
            object.Visible=not modal and not (ownWindow and ownWindow:IsA("GuiObject") and ownWindow.Visible)
        end
    end
    local context=playerGui:FindFirstChild("ContextActionGui")
    if context and context:IsA("ScreenGui") then context.Enabled=not modal end
    local flight=playerGui:FindFirstChild("FlightControls")
    if flight and flight:IsA("ScreenGui") then flight.Enabled=not modal end
    local hud=playerGui:FindFirstChild("TrainingRifleHUD")
    if hud and hud:IsA("ScreenGui") then hud.Enabled=not modal end
end
local function bind(object: Instance)
    if not object:IsA("GuiObject") or watched[object]
        or (not windows[object.Name] and not launchers[object.Name]) then return end
    -- Limit matches to this game's top-level screens, not similarly named chat rows.
    local screen=object:FindFirstAncestorOfClass("ScreenGui")
    if not screen or not ({MilitaryMenu=true,MilitaryMessenger=true,MilitaryExams=true,AdminTargetPicker=true})[screen.Name] then return end
    watched[object]=true
    local connection: RBXScriptConnection?=nil
    connection=object:GetPropertyChangedSignal("Visible"):Connect(refresh)
    object.Destroying:Once(function()
        watched[object]=nil
        if connection then connection:Disconnect() end
        task.defer(refresh)
    end)
    task.defer(refresh)
end
-- Some UI helpers parent buttons before assigning their final names.
playerGui.DescendantAdded:Connect(function(object) task.defer(bind,object) end)
for _,object in playerGui:GetDescendants() do bind(object) end
local viewportConnection: RBXScriptConnection?=nil
local function cameraChanged()
    if viewportConnection then viewportConnection:Disconnect() end
    local camera=workspace.CurrentCamera
    if camera then viewportConnection=camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh) end
    refresh()
end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(cameraChanged)
cameraChanged()
