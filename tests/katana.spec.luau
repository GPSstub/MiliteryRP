--!strict
local R=require("../src/shared/KatanaRules")
local s=R.new()
assert(not R.trySwing(s,1))
R.equip(s,1)
assert(not R.trySwing(s,1.2))
assert(R.trySwing(s,1.36))
assert(not R.trySwing(s,1.37))
assert(R.trySwing(s,2.02))
local old=s.serial
R.unequip(s)
assert(s.serial~=old and not R.trySwing(s,10))
R.equip(s,11)
assert(not R.trySwing(s,11.2) and R.trySwing(s,11.4))
for _,n in {0/0,math.huge,-math.huge} do
 assert(not R.trySwing(s,n))
 assert(not R.inReach(n,1,0))
 assert(not R.inReach(3,n,0))
 assert(not R.inReach(3,1,n))
end
assert(R.inReach(4,.9,1))
assert(not R.inReach(6,1,0))
assert(not R.inReach(3,-1,0))
assert(not R.inReach(3,1,4))
assert(R.canDamage(false,false,false,false))
assert(not R.canDamage(true,false,true,true))
assert(not R.canDamage(false,true,false,false))
assert(R.canDamage(false,true,true,false))
assert(R.canDamage(false,false,false,true))
print("PASS: katana draw delay, cooldown, cancellation, invalid time/geometry, reach/cone/height and friendly-fire policy")
