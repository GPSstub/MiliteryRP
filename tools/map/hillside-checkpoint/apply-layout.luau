local root=workspace.AcademyCampus
local backup=game.ServerStorage.BeforeHillside_20261022
local staging=game.ServerStorage.HillsideAdditions
assert(#staging:GetDescendants()>2900,'New environment must be complete')
local walls=Instance.new('Folder');walls.Name='RemovedRoomPartitions';walls.Parent=backup
local removed=0
for _,p in plan.buildings do
 local zone=nil
 for _,z in root:GetChildren() do if z:IsA('Model') and tonumber(z.Name:sub(1,2))==p[1] then zone=z break end end
 assert(zone,'Building missing')
 local usable=p[8]-18;local count=math.max(2,math.floor(usable/26));local rw=usable/count
 for _,v in zone:GetDescendants() do
  if v:IsA('BasePart') and v.Name=='실 구획벽' then
   local j=math.round((v.Position.X-(p[2]-p[8]/2+16))/rw)
   if j>0 and (j%2==1 or (count%2==1 and j==count-1)) then
    v:SetAttribute('OriginalBuilding',zone.Name);v.Parent=walls;removed+=1
   end
  elseif v:IsA('TextLabel') and v.Text:match('^%d%d%d') then
   v.Text=v.Text:gsub('^%d%d%d%s+','공용 ')
  end
 end
 local delta=CFrame.new(p[4],p[6],p[5])*CFrame.Angles(0,math.rad(p[7]),0)*CFrame.new(-p[2],0,-p[3])
 zone:SetAttribute('HillsideElevation',p[6]);zone:SetAttribute('HillsideYaw',p[7])
 zone:PivotTo(delta*zone:GetPivot())
 task.wait()
end
